# Copy this file to .env and add your secret API key.
# Never commit .env or place the key in frontend JavaScript.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_IMAGE_MODEL=gpt-image-2
PORT=3000

# Owner admin panel (admin.html). All three values are REQUIRED for login.
# There is no default username or password; choose your own before starting.
ADMIN_USERNAME=your_admin_username_here
ADMIN_PASSWORD=replace_with_a_long_random_password
# Long random string used to sign the 8-hour admin session cookie.
# Use 32+ random characters. Changing it signs out every admin session.
ADMIN_SESSION_SECRET=replace_with_a_long_random_session_secret
