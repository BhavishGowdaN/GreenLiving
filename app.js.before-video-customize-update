const heroVideo = document.getElementById("heroVideo");
const videoNumber = document.getElementById("videoNumber");

let currentVideoIndex = 0;
let homeVideoFailures = 0;

function playGardenVideo(index) {
    if (!heroVideo) return;

    currentVideoIndex = index;
    heroVideo.classList.add("video-changing");
    heroVideo.src = gardenVideos[index];
    heroVideo.load();
}

function nextHomeVideo() {
    currentVideoIndex =
        (currentVideoIndex + 1) % gardenVideos.length;

    playGardenVideo(currentVideoIndex);
}

if (heroVideo) {
    heroVideo.addEventListener("canplay", () => {
        heroVideo.play().then(() => {
            homeVideoFailures = 0;
            heroVideo.classList.remove("video-changing");

            if (videoNumber) {
                videoNumber.textContent =
                    String(currentVideoIndex + 1).padStart(2, "0") + " / 06";
            }
        }).catch(error => {
            console.warn("Home video autoplay:", error);
        });
    });

    heroVideo.addEventListener("ended", nextHomeVideo);

    heroVideo.addEventListener("error", () => {
        console.error("Home video could not load:", heroVideo.currentSrc);

        homeVideoFailures++;

        if (homeVideoFailures < gardenVideos.length) {
            nextHomeVideo();
        }
    });

    playGardenVideo(0);
}


