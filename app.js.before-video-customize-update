function changeStudioVideo(space) {
    const data = studioVideos[space];

    if (!data || !studioVideo) return;

    const request = ++studioRequest;

    studioVideo.classList.add("changing");

    studioTitle.innerHTML = data.title;
    studioSubtitle.textContent = data.subtitle;

    studioResult.innerHTML =
        `Selected: <strong>${space} Garden</strong>`;

    if (studioSpaceCopy && spaceCopy[space]) {
        studioSpaceCopy.textContent = spaceCopy[space];
    }

    spaceOptions.forEach(button => {
        button.classList.toggle(
            "active",
            button.dataset.space === space
        );
    });

    studioVideo.pause();
    studioVideo.src = data.video;
    studioVideo.load();

    studioVideo.oncanplay = () => {
        if (request !== studioRequest) return;

        studioVideo.play().then(() => {
            studioVideo.classList.remove("changing");
        }).catch(error => {
            console.warn("Studio video playback:", error);
        });
    };

    studioVideo.onerror = () => {
        if (request === studioRequest) {
            console.error("Missing studio video:", data.video);
            showToast("Please check the garden video filename.");
        }
    };
}

