        addToCart(Number(addButton.dataset.id));
    } else if (buyButton) {
        const product = products.find(item => item.id === Number(buyButton.dataset.id));
        if (product) openCheckout([{ ...product, quantity: Math.max(1, Math.min(20, Number(document.getElementById("modalProductQuantity")?.value) || 1)) }], "buy-now");
    } else if (wishButton) {
        toggleWishlist(Number(wishButton.dataset.id));
    } else if (removeButton) {
        removeFromCart(removeButton.dataset.remove);
    } else if (quantityButton) {
        changeCartQuantity(quantityButton.dataset.id, Number(quantityButton.dataset.qtyChange));
    }
});


