    <form class="customizer-form" id="customPlantForm">
      <div class="customizer-form-title"><span aria-hidden="true">❧</span><h3>Create Your Personalized Plant</h3></div>
      <div class="customizer-field-grid">
        <label>Customization Type<select name="customizationType" id="customizationType" required><option value="Indoor">Personalized Plant</option><option value="Balcony">Balcony Plant</option><option value="Gift">Gift Plant</option></select></label>
