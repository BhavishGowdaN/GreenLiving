<!-- PRODUCT DETAILS MODAL -->
<div class="modal-backdrop" id="productModal">
 
    <div class="product-modal" role="dialog" aria-modal="true" aria-labelledby="modalName">

        <button class="modal-close" id="modalClose" aria-label="Close plant details">×</button>
 
        <div class="modal-image">
            <img id="modalImage" src="" alt="Selected plant">
        </div>
 
        <div class="modal-info">
 
            <p class="eyebrow" id="modalCategory">PLANT</p>
 
            <h2 id="modalName">Plant name</h2>
 
            <p class="modal-price" id="modalPrice"></p>
 
            <p id="modalDescription"></p>
 
 
            <div class="plant-details">
 
                <div>
                    <span>☀️</span>
                    <strong>Light</strong>
                    <small id="modalLight"></small>
                </div>
 
                <div>
                    <span>💧</span>
                    <strong>Water</strong>
                    <small id="modalWater"></small>
                </div>
 
                <div>
                    <span>🌱</span>
                    <strong>Care</strong>
                    <small id="modalCare"></small>
                </div>
 
            </div>
 
 
            <div class="modal-product-quantity"><label for="modalProductQuantity">Quantity</label><input id="modalProductQuantity" type="number" min="1" max="20" value="1"></div>
            <div id="modalPotDetails" class="modal-pot-details" hidden></div>
            <p class="modal-stock-status" id="modalStockStatus">Availability: In stock</p>
            <div id="modalRelatedProducts" class="modal-related-products"></div>
            <div class="modal-actions">
                <button class="btn btn-dark full-btn" id="modalAddCart">
                    Add to Cart
                </button>
                <button class="btn btn-outline-dark full-btn" id="modalBuyNow">
                    Buy Now
                </button>
            </div>
 
        </div>
 
    </div>
 
</div>
 
 
<!-- CHECKOUT -->
<div class="modal-backdrop checkout-backdrop" id="checkoutModal">

    <div class="checkout-modal" role="dialog" aria-modal="true" aria-labelledby="checkoutTitle">

        <button class="modal-close" id="checkoutClose" aria-label="Close checkout">×</button>

        <div id="checkoutFormView">

            <header class="checkout-header">
                <p class="eyebrow">SECURE CHECKOUT</p>
                <h2 id="checkoutTitle">Complete your order</h2>
                <p>Fresh from the nursery, delivered with care.</p>
            </header>

            <div class="checkout-layout">

                <form class="checkout-form" id="checkoutForm">

                    <fieldset>
                        <legend>Delivery details</legend>

                        <div class="checkout-field">
                            <label for="fullName">Full name</label>
                            <input id="fullName" name="fullName" type="text" autocomplete="name" required>
                        </div>

                        <div class="checkout-field-row">
                            <div class="checkout-field">
                                <label for="phone">Phone</label>
                                <input id="phone" name="phone" type="tel" autocomplete="tel" required>
                            </div>
                            <div class="checkout-field">
                                <label for="email">Email</label>
                                <input id="email" name="email" type="email" autocomplete="email" required>
                            </div>
                        </div>

                        <div class="checkout-field">
                            <label for="address">Address</label>
                            <input id="address" name="address" type="text" autocomplete="street-address" required>
                        </div>

                        <div class="checkout-field-row">
                            <div class="checkout-field">
                                <label for="city">City</label>
                                <input id="city" name="city" type="text" autocomplete="address-level2" required>
                            </div>
                            <div class="checkout-field">
                                <label for="pincode">PIN code</label>
                                <input id="pincode" name="pincode" type="text" inputmode="numeric" autocomplete="postal-code" required>
                            </div>
                        </div>
                    </fieldset>

                    <fieldset>
                        <legend>Payment</legend>

                        <div class="payment-options">
                            <label class="payment-option">
                                <input type="radio" name="paymentMethod" value="COD" checked>
                                <span>
                                    <strong>Cash on Delivery</strong>
                                    <small>Pay when your plants arrive</small>
                                </span>
                            </label>

                            <label class="payment-option">
                                <input type="radio" name="paymentMethod" value="UPI">
                                <span>
                                    <strong>UPI</strong>
                                    <small>Demo only — no payment collected</small>
                                </span>
                            </label>
                        </div>

                        <div class="upi-fields" id="upiFields" hidden>
                            <div class="checkout-field">
                                <label for="upiId">UPI ID</label>
                                <input id="upiId" name="upiId" type="text" placeholder="name@bank">
                            </div>
                        </div>
                    </fieldset>

                    <button class="btn btn-dark full-btn" type="submit">Place order</button>
                    <p class="checkout-note">Demo store — orders are saved in this browser only.</p>

                </form>

                <aside class="checkout-summary">
                    <h3>Order summary</h3>
                    <div id="checkoutSummary" class="checkout-summary-list"></div>
                    <div class="checkout-breakdown">
                        <div><span>Subtotal</span><strong id="checkoutSubtotal">₹0</strong></div>
                        <div><span>Delivery</span><strong id="checkoutDelivery">Free</strong></div>
                    </div>
                    <div class="checkout-total">
                        <span>Total</span>
                        <strong id="checkoutGrandTotal">₹0</strong>
                    </div>
                </aside>

            </div>
        </div>

        <div class="order-view" id="orderSuccessView" hidden>
            <div class="order-badge" aria-hidden="true">✓</div>
            <p class="eyebrow">ORDER CONFIRMED</p>
            <h2>Your plants are on their way.</h2>
            <p>Thank you, <strong id="successCustomerName"></strong>. We will take good care of your green friends.</p>

            <div class="order-facts">
                <div><span>Order</span><strong id="successOrderNumber"></strong></div>
                <div><span>Payment</span><strong id="successPaymentMethod"></strong></div>
                <div><span>Arrives</span><strong id="successEta"></strong></div>
            </div>

            <div class="order-items" id="successOrderItems"></div>

            <div class="order-breakdown">
                <div><span>Subtotal</span><strong id="successSubtotal"></strong></div>
                <div><span>Delivery</span><strong id="successDelivery"></strong></div>
                <div class="order-breakdown-total"><span>Total</span><strong id="successOrderTotal"></strong></div>
            </div>

            <div class="order-actions">
                <button class="btn btn-dark" id="trackOrderButton" type="button">Track order</button>
                <button class="btn btn-outline-dark" id="continueShoppingButton" type="button">Continue shopping</button>
            </div>
        </div>

        <div class="order-view" id="orderTrackingView" hidden>
            <p class="eyebrow">LIVE ORDER TRACKING</p>
            <h2>Order <span id="trackingOrderNumber"></span></h2>
            <p class="tracking-address">
                <strong id="trackingDeliveryName"></strong>
                <span id="trackingDeliveryAddress"></span>
            </p>

            <p class="tracking-eta" id="trackingEta"></p>

            <div class="tracking-progress" aria-hidden="true">
                <span id="trackingProgressBar"></span>
            </div>

            <div class="tracking-timeline" id="trackingTimeline"></div>

            <div class="tracking-items" id="trackingItems"></div>

            <div class="checkout-total">
                <span>Order total</span>
                <strong id="trackingTotal"></strong>
            </div>

            <div class="order-actions">
                <button class="btn btn-outline-dark" id="backToConfirmation" type="button">Back to confirmation</button>
                <button class="btn btn-dark" id="closeTrackingButton" type="button">Done</button>
            </div>
        </div>

    </div>
</div>


