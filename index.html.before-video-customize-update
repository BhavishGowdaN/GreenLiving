        <label>Pot Style<select name="pot" id="customPot" required><option>Premium Ceramic Pot</option><option>Modern Minimalist Pot</option><option>Terracotta Pot</option><option>Decorative Designer Pot</option><option>Hanging Planter</option><option>Balcony Planter</option><option>Small Desk Pot</option><option>Large Floor Pot</option></select></label>
        <label>Pot Colour<select name="potColor" id="customPotColor" required><option>Matte White</option><option>Terracotta</option><option>Matte Black</option><option>Sage Green</option><option>Cream</option><option>Pastel Pink</option><option>Natural Beige</option></select></label>
        <label>Pot Size<select name="potSize" id="customPotSize" required><option>Small</option><option selected>Medium</option><option>Large</option></select></label>
        <label>Plant Arrangement<select name="arrangement" id="customArrangement"><option>Single centered plant</option><option>Lush and full</option><option>Multiple stems</option><option>Compact arrangement</option><option>Natural spreading arrangement</option></select></label>
        <label class="customizer-full-field">Background / Environment<select name="environment" id="customEnvironment"><option>Warm minimalist home</option><option>Modern living room</option><option>Balcony</option><option>Office</option><option>Garden</option><option>Botanical studio</option><option>Natural wooden interior</option></select></label>
        <label>Customer Name<input name="customerName" id="customCustomerName" maxlength="60" autocomplete="name" placeholder="Your name" required></label>
        <label>Text to Print on Pot<input name="personalizationText" id="customPotText" maxlength="36" placeholder="e.g. Welcome Home" required></label>
        <label class="customizer-full-field">Custom Message <span>(Optional)</span><textarea name="customMessage" id="customMessage" maxlength="300" rows="2" placeholder="A little greenery for a happier home..."></textarea></label>
      </div>
      <div class="custom-plant-care-block">
        <div class="custom-info-heading"><span>❧</span><div><p class="eyebrow">PLANT PROFILE</p><h3>Selected Plant Information</h3></div></div>
