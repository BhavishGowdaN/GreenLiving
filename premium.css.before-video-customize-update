/* =========================================================
   25. AUTHORITATIVE COLOUR PALETTE — FINAL BRAND TOKENS
   Warm Beige × Ivory × Forest Green × Olive × Sage ×
   Champagne Gold × Charcoal
   This layer loads last and wins the cascade. It remaps the
   --gl-* token system, neutralizes the legacy BloomSpace
   neon layer (#A8F044) and locks both theme palettes.
   ========================================================= */

/* --- 25.1 Light-mode brand tokens --- */
:root {
    /* Surfaces */
    --gl-ivory: #F5F1E8;        /* main background */
    --gl-paper: #FFFCF5;        /* premium card */
    --gl-sand: #EDE7DA;         /* secondary background */
    --gl-sand-deep: #E7DFD0;    /* alternate section */
    --gl-cream: #F8F4EA;        /* soft cream */
    --gl-beige: #D8CBB5;        /* warm beige */

    /* Greens */
    --gl-forest: #244536;       /* deep forest green — headings, dark panels */
    --gl-deep: #244536;         /* buttons / dark green sections */
    --gl-deep-soft: #526F50;    /* botanical green — hover, secondary headings */
    --gl-moss: #82965C;         /* olive — highlights, accents */
    --gl-sage: #A4B39A;         /* sage — soft accents */
    --gl-sage-light: #E7EBDD;   /* pale sage surface */
    --gl-teal: #103C43;         /* dark teal detail */

    /* Warm accents */
    --gl-gold: #B99A62;         /* champagne gold */
    --gl-terracotta: #B96F48;   /* terracotta accent */

    /* Text */
    --gl-ink: #343A32;          /* charcoal — main body text */
    --gl-on-deep: #F8F4EA;      /* text on dark green */
    --gl-muted: #777264;        /* secondary descriptions */
    --gl-nav: #344B3B;          /* navigation links */

    /* Lines & shadows */
    --gl-line: #DED6C7;         /* fine borders */
    --gl-shadow-sm: 0 2px 12px rgba(36, 69, 54, 0.06);
    --gl-shadow-md: 0 16px 44px rgba(36, 69, 54, 0.10);
    --gl-shadow-lg: 0 34px 80px rgba(36, 69, 54, 0.16);
}

/* Neutralize the legacy :root tokens (styles.css) — the
   BloomSpace layer redefines these as neon; re-declare the
   brand values here so every var() usage resolves correctly. */
:root {
    --green: #526F50;
    --dark-green: #244536;
    --light-green: #E7DFD0;
    --cream: #F5F1E8;
    --white: #FFFCF5;
    --text: #343A32;
    --muted: #777264;
    --border: #DED6C7;
    --shadow: 0 18px 45px rgba(36, 69, 54, 0.12);
}

/* Typography accents follow the brand palette */
h1 em, h2 em, h3 em,
.section-title em {
    color: var(--gl-moss) !important;
}

/* --- 25.2 Dark-mode brand tokens ---
   Navy #071323 · Forest #102C21 · Card #173D2B ·
   Text #FFFDF7 · Secondary #C5D0C1 · Champagne #C5A66B */
body.dark-mode {
    /* Surfaces */
    --gl-ivory: #071323;
    --gl-paper: #173D2B;
    --gl-sand: #102C21;
    --gl-sand-deep: #102C21;
    --gl-cream: #102C21;
    --gl-beige: #1B3A2C;

    /* Greens & accents */
    --gl-forest: #FFFDF7;       /* headings become ivory on dark */
    --gl-deep: #173D2B;
    --gl-deep-soft: #2F4A3B;
    --gl-moss: #82965C;         /* olive stays as accent */
    --gl-sage: #A4B39A;
    --gl-sage-light: #143023;
    --gl-teal: #103C43;

    /* Warm accents */
    --gl-gold: #C5A66B;         /* champagne (dark variant) */
    --gl-terracotta: #B96F48;

    /* Text */
    --gl-ink: #FFFDF7;
    --gl-on-deep: #FFFDF7;
    --gl-muted: #C5D0C1;
    --gl-nav: #C5D0C1;

    /* Lines & shadows — charcoal for details, not text */
    --gl-line: #345344;
    --gl-shadow-sm: 0 2px 12px rgba(0, 0, 0, 0.35);
    --gl-shadow-md: 0 16px 44px rgba(0, 0, 0, 0.45);
    --gl-shadow-lg: 0 34px 80px rgba(0, 0, 0, 0.55);
}

body.dark-mode {
    --green: #82965C;
    --dark-green: #FFFDF7;
    --light-green: #173D2B;
    --cream: #071323;
    --white: #173D2B;
    --text: #FFFDF7;
    --muted: #C5D0C1;
    --border: #345344;
    --shadow: 0 18px 45px rgba(0, 0, 0, 0.45);
}

