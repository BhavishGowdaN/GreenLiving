body.dark-mode #shop .shop-hero h2,body.dark-mode #shop .shop-hero-subtitle{color:#f3f2e7!important}
body.dark-mode #shop .product-card{background:#1d3928!important;border-color:#405b45!important}
body.dark-mode #shop .product-title-open,body.dark-mode #shop .product-info h3{color:#f2f3e7!important}
body.dark-mode #shop .product-description,body.dark-mode #shop .product-rating{color:#d0ddcd!important}
body.dark-mode #customize .customizer-form{background:rgba(26,53,37,.97)!important;border-color:#49644d!important}
body.dark-mode #customize .customizer-form-title h3,body.dark-mode #customize .custom-info-heading h3{color:#f2f2e6!important}
