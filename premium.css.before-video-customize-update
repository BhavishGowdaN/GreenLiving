/* Gentle botanical movement is decorative and never intercepts interaction. */
body:before{content:'❧';position:fixed;z-index:0;left:2vw;top:24vh;color:rgba(91,133,78,.10);font-size:clamp(50px,9vw,130px);pointer-events:none;animation:glLeafDrift 18s ease-in-out infinite alternate}
body:after{content:'❧';position:fixed;z-index:0;right:2vw;bottom:14vh;color:rgba(91,133,78,.09);font-size:clamp(44px,8vw,112px);pointer-events:none;transform:rotate(155deg);animation:glLeafDrift 22s ease-in-out infinite alternate-reverse}
@keyframes glLeafDrift{0%{translate:0 0;rotate:-8deg}100%{translate:12px -20px;rotate:10deg}}
@media(prefers-reduced-motion:reduce){body:before,body:after{animation:none!important}*,*:before,*:after{scroll-behavior:auto!important;animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
