/* =========================================================
   GREEN LIVING — PREMIUM BOTANICAL LAYER
   "Nature Inside the Architecture"
   Loaded after styles.css. Overrides the visual theme only;
   all layout, markup and JavaScript behaviour is preserved.
   ========================================================= */

/* ---------------------------------------------------------
   01. DESIGN TOKENS
   --------------------------------------------------------- */
:root {
    /* New palette */
    --gl-ink: #24302a;
    --gl-deep: #1f3a2b;
    --gl-deep-soft: #2f523d;
    --gl-on-deep: #f7f3e9;
    --gl-forest: #1f3a2b;
    --gl-moss: #6f8b5f;
    --gl-sage: #a9b89a;
    --gl-sage-light: #e2e8d6;
    --gl-ivory: #f7f3e9;
    --gl-paper: #fffdf7;
    --gl-sand: #ece4d3;
    --gl-sand-deep: #ddd1ba;
    --gl-terracotta: #b06f56;
    --gl-gold: #c2a26a;
    --gl-muted: #6d786a;
    --gl-line: rgba(31, 58, 43, 0.13);

    --gl-shadow-sm: 0 2px 12px rgba(31, 58, 43, 0.05);
    --gl-shadow-md: 0 16px 44px rgba(31, 58, 43, 0.10);
    --gl-shadow-lg: 0 34px 80px rgba(31, 58, 43, 0.16);

    --gl-radius: 24px;
    --gl-radius-sm: 14px;
    --gl-ease: cubic-bezier(0.22, 0.61, 0.36, 1);

    /* Remap legacy tokens so older rules inherit the new look */
    --green: #2f523d;
    --dark-green: #1f3a2b;
    --light-green: #e2e8d6;
    --cream: #f7f3e9;
    --white: #fffdf7;
    --text: #24302a;
    --muted: #6d786a;
    --border: rgba(31, 58, 43, 0.13);
    --shadow: 0 16px 44px rgba(31, 58, 43, 0.10);
}

/* ---------------------------------------------------------
   02. BASE + TYPOGRAPHY
   --------------------------------------------------------- */
html {
    scroll-behavior: smooth;
    scroll-padding-top: 100px;
}

body {
    background:
        radial-gradient(1100px 650px at 88% -8%, rgba(194, 162, 106, 0.14), transparent 62%),
        radial-gradient(900px 620px at -12% 34%, rgba(111, 139, 95, 0.11), transparent 60%),
        var(--gl-ivory) !important;
    color: var(--gl-ink) !important;
    font-family: "DM Sans", sans-serif;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
}

main {
    background: transparent !important;
}

section {
    color: inherit;
}

::selection {
    background: var(--gl-sage);
    color: var(--gl-deep);
}

h1,
h2,
h3 {
    font-family: "Playfair Display", serif;
    font-weight: 500;
    color: var(--gl-forest);
    letter-spacing: -0.015em;
}

h2 {
    font-size: clamp(36px, 4.1vw, 58px);
    line-height: 1.1;
}

h1 em,
h2 em,
h3 em {
    color: var(--gl-moss);
    font-style: italic;
}

p {
    color: var(--gl-muted);
}

.section-padding {
    padding: 112px 8%;
}

.eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--gl-moss) !important;
    font-size: 10px;
    letter-spacing: 0.28em;
    font-weight: 700;
    margin-bottom: 18px;
}

.eyebrow::before {
    content: "";
    display: block;
    width: 32px;
    height: 1px;
    background: currentColor;
    opacity: 0.6;
    flex: 0 0 auto;
}

.eyebrow.light {
    color: #e6ead8 !important;
}

.section-heading {
    align-items: flex-end;
    gap: 40px;
    margin-bottom: 54px;
}

.section-heading > p {
    color: var(--gl-muted) !important;
    font-size: 13px;
    line-height: 1.85;
    max-width: 340px;
}

.muted {
    color: var(--gl-muted) !important;
}

/* Accessibility helpers */
.skip-link {
    position: fixed;
    top: -70px;
    left: 18px;
    z-index: 9999;
    padding: 13px 20px;
    background: var(--gl-deep);
    color: var(--gl-on-deep);
    font-size: 12px;
    letter-spacing: 0.06em;
    border-radius: 0 0 12px 12px;
    transition: top 0.25s var(--gl-ease);
}

.skip-link:focus {
    top: 0;
}

a:focus-visible,
button:focus-visible,
input:focus-visible,
[tabindex]:focus-visible {
    outline: 2px solid var(--gl-terracotta);
    outline-offset: 3px;
}

[hidden] {
    display: none !important;
}

/* ---------------------------------------------------------
   03. BUTTONS
   --------------------------------------------------------- */
.btn {
    border-radius: 999px;
    padding: 15px 28px;
    border: 1px solid transparent;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition:
        transform 0.35s var(--gl-ease),
        box-shadow 0.35s var(--gl-ease),
        background 0.35s var(--gl-ease),
        color 0.35s var(--gl-ease);
}

.btn:hover {
    transform: translateY(-3px);
}

.btn-dark {
    background: var(--gl-deep) !important;
    color: var(--gl-on-deep) !important;
}

.btn-dark:hover {
    background: var(--gl-deep-soft) !important;
    box-shadow: 0 14px 30px rgba(31, 58, 43, 0.24);
}

.btn-light {
    background: var(--gl-paper) !important;
    color: var(--gl-deep) !important;
    box-shadow: 0 10px 28px rgba(9, 22, 14, 0.18);
}

.btn-light:hover {
    background: #ffffff !important;
}

.btn-outline {
    border-color: rgba(247, 243, 233, 0.6) !important;
    color: var(--gl-on-deep) !important;
    backdrop-filter: blur(6px);
}

.btn-outline:hover {
    background: rgba(247, 243, 233, 0.12);
    border-color: rgba(247, 243, 233, 0.9) !important;
}

.btn-outline-dark {
    background: transparent;
    border: 1px solid var(--gl-line);
    color: var(--gl-forest);
}

.btn-outline-dark:hover {
    border-color: var(--gl-forest);
    background: var(--gl-sage-light);
}

.full-btn {
    width: 100%;
    border: 0;
}

/* ---------------------------------------------------------
   04. NAVIGATION
   --------------------------------------------------------- */
.navbar {
    height: 84px;
    padding: 0 6%;
    background: rgba(247, 243, 233, 0.82) !important;
    border-bottom: 1px solid var(--gl-line);
    box-shadow: none !important;
    backdrop-filter: blur(22px) saturate(130%);
    -webkit-backdrop-filter: blur(22px) saturate(130%);
}

.navbar.scrolled {
    background: rgba(247, 243, 233, 0.95) !important;
    box-shadow: 0 14px 36px rgba(31, 58, 43, 0.07) !important;
}

.logo,
body.dark-mode .logo {
    color: var(--gl-forest) !important;
    font-size: 26px;
    letter-spacing: -0.01em;
}

.logo span {
    color: var(--gl-moss) !important;
}

.logo-leaf {
    color: var(--gl-moss);
}

.nav-links {
    gap: 34px;
}

.nav-links a {
    color: #5f6b5d !important;
    font-size: 11.5px;
    letter-spacing: 0.07em;
    padding: 10px 0;
}

.nav-links a:hover,
.nav-links a.active {
    color: var(--gl-forest) !important;
}

.nav-links a::after {
    background: var(--gl-terracotta) !important;
    height: 1.5px;
}

.icon-btn,
.menu-toggle {
    color: var(--gl-forest) !important;
}

.icon-btn {
    font-size: 19px;
}

.cart-button span {
    background: var(--gl-terracotta) !important;
    color: #fff !important;
    top: -8px;
    right: -10px;
}

/* ---------------------------------------------------------
   05. HERO
   --------------------------------------------------------- */
.hero {
    min-height: 740px;
    padding: 0 8%;
    background: #14261c;
}

.hero-overlay {
    background: linear-gradient(
        100deg,
        rgba(12, 27, 19, 0.88) 0%,
        rgba(12, 27, 19, 0.58) 46%,
        rgba(12, 27, 19, 0.12) 100%
    ) !important;
}

.hero-content {
    max-width: 660px;
}

.hero h1 {
    color: #fbf9f2;
    font-size: clamp(54px, 7vw, 96px);
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin-bottom: 28px;
}

.hero h1 em {
    color: #d8e2c4 !important;
}

.hero-description {
    color: #eef0e4 !important;
    font-size: 15px;
    line-height: 1.9;
    max-width: 480px;
    margin-bottom: 36px;
}

.hero-buttons {
    gap: 14px;
}

.hero-green-card {
    position: absolute;
    right: 6%;
    bottom: 11%;
    z-index: 4;
    width: 248px;
    padding: 26px 26px 24px;
    border-radius: 22px;
    background: rgba(18, 36, 26, 0.52);
    border: 1px solid rgba(247, 243, 233, 0.22);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    color: var(--gl-on-deep);
    box-shadow: 0 24px 60px rgba(6, 16, 10, 0.32);
}

.hero-card-leaf {
    display: block;
    font-size: 26px;
    color: #d3dfbd;
    margin-bottom: 10px;
}

.hero-green-card h2 {
    color: #fbf9f2 !important;
    font-size: 25px;
    line-height: 1.18;
    margin-bottom: 8px;
}

.hero-green-card p {
    color: #d6ddc9 !important;
    font-size: 11px;
    line-height: 1.7;
}

.video-indicator {
    margin-top: 58px;
    color: #dfe4d2;
    letter-spacing: 0.12em;
}

.video-dot {
    background: #cfdcb6;
    box-shadow: 0 0 12px #cfdcb6;
}

.scroll-down {
    right: 8%;
    bottom: 38px;
    color: #e8ebdc;
    letter-spacing: 0.22em;
    font-size: 9px;
}

/* ---------------------------------------------------------
   06. INTRO
   --------------------------------------------------------- */
.intro {
    background: transparent !important;
    border-top: 1px solid var(--gl-line);
    padding-top: 96px;
    padding-bottom: 96px;
}

.intro h2 {
    color: var(--gl-forest) !important;
}

.intro h2 em {
    color: var(--gl-moss) !important;
}

.intro-text {
    color: var(--gl-muted) !important;
    font-size: 15px;
    line-height: 1.95;
    max-width: 460px;
}

/* ---------------------------------------------------------
   07. GARDEN STUDIO
   --------------------------------------------------------- */
.studio-section {
    background: linear-gradient(180deg, #efe9db 0%, #f4efe4 100%) !important;
}

.studio-section .section-heading > p {
    color: var(--gl-muted) !important;
    font-size: 14px;
}

.studio-main {
    border-radius: 26px;
    box-shadow: var(--gl-shadow-lg);
    background: #14261c;
}

.studio-video {
    border-radius: 26px;
}

.studio-card-content {
    left: 40px;
    bottom: 40px;
}

.studio-card-content span {
    color: #d8e2c4;
    letter-spacing: 0.24em;
    font-size: 9px;
}

.studio-card-content h3 {
    color: #fbf9f2;
    font-size: 38px;
    line-height: 1.18;
}

.studio-card-content .text-link {
    color: #fbf9f2;
    border-bottom: 1px solid rgba(247, 243, 233, 0.45);
    padding-bottom: 3px;
    font-size: 11px;
    letter-spacing: 0.08em;
}

.studio-options {
    gap: 14px;
}

.space-option {
    background: rgba(255, 253, 247, 0.9) !important;
    border: 1px solid var(--gl-line) !important;
    border-radius: 18px !important;
    color: var(--gl-forest) !important;
    box-shadow: var(--gl-shadow-sm);
    backdrop-filter: blur(10px);
}

.space-option:hover,
.space-option.active {
    background: var(--gl-paper) !important;
    border-color: var(--gl-moss) !important;
    box-shadow: var(--gl-shadow-md) !important;
    transform: translateY(-3px) !important;
}

.space-option strong {
    color: var(--gl-forest) !important;
    font-size: 13px;
    letter-spacing: 0.01em;
}

.space-option small {
    color: var(--gl-muted) !important;
    font-size: 10.5px;
}

.space-icon {
    background: var(--gl-sage-light) !important;
    color: var(--gl-forest) !important;
    border-radius: 14px !important;
}

.space-option .option-arrow {
    color: var(--gl-moss) !important;
}

.studio-result {
    color: var(--gl-muted) !important;
    letter-spacing: 0.03em;
}

/* ---------------------------------------------------------
   08. 3D STUDIO PANEL
   --------------------------------------------------------- */
.studio-3d-panel {
    height: 600px !important;
    min-height: 600px !important;
    border-radius: 30px !important;
    border: 1px solid rgba(223, 231, 212, 0.2) !important;
    background:
        radial-gradient(circle at 72% 20%, rgba(194, 162, 106, 0.22), transparent 40%),
        radial-gradient(circle at 54% 78%, rgba(111, 139, 95, 0.34), transparent 44%),
        linear-gradient(118deg, #14261c 0%, #213d2c 55%, #2b4836 100%) !important;
    box-shadow: 0 40px 90px rgba(20, 38, 28, 0.32) !important;
}

.studio-3d-panel::before {
    background:
        radial-gradient(circle at 70% 12%, rgba(194, 162, 106, 0.16), transparent 32%),
        radial-gradient(circle at 54% 66%, rgba(169, 184, 154, 0.18), transparent 38%) !important;
}

.studio-3d-copy {
    left: 5% !important;
    top: 17% !important;
    width: 32% !important;
}

.studio-3d-copy h3.modern-studio-heading,
.studio-3d-copy h3.modern-studio-heading .heading-line {
    color: #f7f3e9 !important;
    font-family: "Armelie", "Playfair Display", cursive !important;
    font-size: clamp(34px, 3vw, 44px) !important;
    line-height: 1.22 !important;
}

.studio-3d-copy h3.modern-studio-heading .gradient-text {
    background: linear-gradient(100deg, #f2ead6 0%, #d5e0c2 45%, #a9b89a 100%) !important;
    -webkit-background-clip: text !important;
    background-clip: text !important;
    -webkit-text-fill-color: transparent !important;
    color: transparent !important;
}

.studio-3d-copy > p:not(.eyebrow) {
    color: rgba(240, 243, 232, 0.76) !important;
    font-family: "DM Sans", sans-serif !important;
    font-size: 12.5px !important;
    letter-spacing: 0.03em !important;
}

.studio-3d-copy .eyebrow {
    color: #cfdcb6 !important;
}

.studio-3d-copy .eyebrow::before {
    background: #cfdcb6;
}

.studio-3d-copy .calligraphy-flourish {
    filter: drop-shadow(0 0 6px rgba(207, 220, 182, 0.22)) !important;
}

.plant-viewer-controls button {
    background: rgba(247, 243, 233, 0.08) !important;
    color: #f4f1e5 !important;
    border: 1px solid rgba(247, 243, 233, 0.28) !important;
    box-shadow: none !important;
    letter-spacing: 0.04em;
}

.plant-viewer-controls button:last-child {
    background: #e9e3d2 !important;
    color: var(--gl-deep) !important;
    border-color: transparent !important;
}

.plant-viewer-controls button:hover {
    background: rgba(247, 243, 233, 0.16) !important;
    transform: translateY(-2px);
}

.plant-viewer-controls button:last-child:hover {
    background: #f7f3e9 !important;
}

.plant-loading {
    background: rgba(15, 30, 21, 0.62) !important;
    color: #e9e3d2 !important;
    border: 1px solid rgba(247, 243, 233, 0.22) !important;
    letter-spacing: 0.06em;
}

.plant-error {
    color: #f0c9b8 !important;
}

.three-d-label {
    color: #cfdcb6 !important;
}

/* ---------------------------------------------------------
   09. DASHBOARD
   --------------------------------------------------------- */
.dashboard-section {
    background: var(--gl-ivory) !important;
}

.dashboard-card {
    background: var(--gl-paper) !important;
    border: 1px solid var(--gl-line) !important;
    border-radius: 22px !important;
    color: var(--gl-ink) !important;
    box-shadow: var(--gl-shadow-sm) !important;
    backdrop-filter: none !important;
    padding: 32px;
}

.dashboard-card:hover {
    border-color: var(--gl-sage) !important;
    box-shadow: var(--gl-shadow-md) !important;
}

.card-label {
    color: var(--gl-moss) !important;
    letter-spacing: 0.22em;
    font-size: 9.5px;
}

.dashboard-card h3 {
    color: var(--gl-forest) !important;
}

.dashboard-card > p:not(.card-label) {
    color: var(--gl-muted) !important;
}

.score-circle {
    border-color: var(--gl-sage-light) !important;
    border-right-color: var(--gl-moss) !important;
    border-bottom-color: var(--gl-moss) !important;
}

.score-circle strong {
    color: var(--gl-forest);
}

.score-circle small {
    color: var(--gl-muted) !important;
}

.growth-stats strong {
    color: var(--gl-forest) !important;
    font-size: 26px;
}

.growth-stats span {
    color: var(--gl-muted) !important;
}

.growth-bar,
.challenge-progress {
    background: var(--gl-sage-light) !important;
    height: 6px;
}

.growth-bar span,
.challenge-progress span {
    background: linear-gradient(90deg, var(--gl-moss), var(--gl-sage)) !important;
}

.care-item {
    border-color: var(--gl-line) !important;
}

.care-item strong {
    color: var(--gl-forest) !important;
}

.care-item small {
    color: var(--gl-muted) !important;
}

.care-status {
    color: var(--gl-terracotta) !important;
    font-size: 9.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.challenge-icon {
    filter: drop-shadow(0 6px 12px rgba(111, 139, 95, 0.25));
}

/* ---------------------------------------------------------
   10. SHOP + PRODUCT CARDS
   --------------------------------------------------------- */
.shop-section {
    background: linear-gradient(180deg, #f3eee2 0%, #f7f3e9 100%) !important;
}

.search-box {
    height: 48px;
    border: 1px solid var(--gl-line) !important;
    border-radius: 999px !important;
    background: var(--gl-paper) !important;
    box-shadow: var(--gl-shadow-sm);
}

.search-box input {
    color: var(--gl-ink) !important;
    font-size: 12.5px;
    padding: 0 20px;
}

.search-box input::placeholder {
    color: #98a092;
}

.search-box button {
    color: var(--gl-forest) !important;
}

.category-list {
    gap: 9px;
    margin-bottom: 38px;
}

.category-btn {
    background: transparent !important;
    border: 1px solid var(--gl-line) !important;
    color: var(--gl-muted) !important;
    border-radius: 999px !important;
    padding: 11px 20px;
    font-size: 10.5px;
    letter-spacing: 0.08em;
}

.category-btn:hover {
    transform: translateY(-2px);
    border-color: var(--gl-moss) !important;
    color: var(--gl-forest) !important;
}

.category-btn.active,
.category-btn:hover {
    background: var(--gl-deep) !important;
    color: var(--gl-on-deep) !important;
    border-color: var(--gl-deep) !important;
}

.product-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 26px;
}

.product-card {
    background: var(--gl-paper) !important;
    border: 1px solid var(--gl-line) !important;
    border-radius: 20px !important;
    box-shadow: var(--gl-shadow-sm);
    overflow: hidden;
    animation: glCardIn 0.7s var(--gl-ease) backwards;
}

.product-card:hover {
    border-color: var(--gl-sage) !important;
    box-shadow: var(--gl-shadow-lg) !important;
}

.product-card:nth-child(2) { animation-delay: 0.05s; }
.product-card:nth-child(3) { animation-delay: 0.10s; }
.product-card:nth-child(4) { animation-delay: 0.15s; }
.product-card:nth-child(5) { animation-delay: 0.20s; }
.product-card:nth-child(6) { animation-delay: 0.25s; }
.product-card:nth-child(7) { animation-delay: 0.30s; }
.product-card:nth-child(8) { animation-delay: 0.35s; }

.product-image-wrap {
    height: auto !important;
    aspect-ratio: 4 / 5;
    background: var(--gl-sand) !important;
}

.product-image-wrap img {
    height: 100%;
    object-fit: cover;
}

.product-tag {
    top: 14px;
    left: 14px;
    padding: 8px 12px;
    border-radius: 999px !important;
    background: rgba(247, 243, 233, 0.92) !important;
    color: var(--gl-forest) !important;
    font-size: 8px;
    letter-spacing: 0.14em;
    backdrop-filter: blur(8px);
}

.wishlist-btn {
    top: 12px;
    right: 12px;
    width: 38px;
    height: 38px;
    background: rgba(247, 243, 233, 0.92) !important;
    color: var(--gl-forest) !important;
    font-size: 18px;
    box-shadow: 0 4px 12px rgba(31, 58, 43, 0.12);
}

.wishlist-btn.liked {
    color: var(--gl-terracotta) !important;
}

.product-info {
    padding: 20px 20px 22px;
}

.product-category {
    color: var(--gl-moss) !important;
    font-size: 8.5px;
    letter-spacing: 0.2em;
}

.product-info h3 {
    color: var(--gl-forest) !important;
    font-size: 21px;
    margin: 8px 0 7px;
}

.product-description {
    color: var(--gl-muted) !important;
    font-size: 11.5px;
    line-height: 1.65;
    min-height: 0;
    margin-bottom: 15px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

/* Dynamic classes rendered by app.js that had no styles before */
.product-price-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    padding-top: 15px;
    border-top: 1px solid var(--gl-line);
}

.product-price {
    color: var(--gl-forest) !important;
    font-family: "Playfair Display", serif;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.01em;
}

.delivery-note {
    color: var(--gl-moss);
    font-size: 9px;
    letter-spacing: 0.03em;
    text-align: right;
    line-height: 1.4;
}

.delivery-note::before {
    content: "❧ ";
    opacity: 0.8;
}

.product-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: 15px;
}

.add-cart-btn,
.buy-now-btn {
    border-radius: 999px !important;
    padding: 11px 8px;
    font-size: 9.5px;
    letter-spacing: 0.06em;
    font-weight: 700;
    transition:
        background 0.3s var(--gl-ease),
        color 0.3s var(--gl-ease),
        border-color 0.3s var(--gl-ease),
        transform 0.3s var(--gl-ease);
}

.add-cart-btn {
    background: var(--gl-deep) !important;
    color: var(--gl-on-deep) !important;
    border: 1px solid var(--gl-deep) !important;
}

.add-cart-btn:hover {
    background: var(--gl-deep-soft) !important;
    color: var(--gl-on-deep) !important;
    transform: translateY(-2px);
}

.buy-now-btn {
    background: transparent !important;
    color: var(--gl-forest) !important;
    border: 1px solid var(--gl-line) !important;
}

.buy-now-btn:hover {
    background: var(--gl-sage-light) !important;
    border-color: var(--gl-moss) !important;
    transform: translateY(-2px);
}

.empty-message {
    color: var(--gl-muted);
    font-size: 13px;
}

/* ---------------------------------------------------------
   11. PLANT PASSPORT
   --------------------------------------------------------- */
.passport-section {
    background: var(--gl-sand) !important;
}

.passport-image {
    border-radius: 28px;
    box-shadow: var(--gl-shadow-lg);
}

.passport-image img {
    border-radius: 28px;
}

.passport-content h2 {
    color: var(--gl-forest) !important;
}

.passport-content p:not(.eyebrow) {
    color: var(--gl-muted) !important;
    font-size: 14px;
    line-height: 1.9;
}

/* ---------------------------------------------------------
   12. BENEFITS
   --------------------------------------------------------- */
.benefits-section {
    background: var(--gl-ivory) !important;
    gap: 26px;
}

.benefit {
    background: var(--gl-paper) !important;
    border: 1px solid var(--gl-line) !important;
    border-radius: 22px !important;
    padding: 42px 28px;
    box-shadow: var(--gl-shadow-sm);
}

.benefit:hover {
    border-color: var(--gl-sage);
    box-shadow: var(--gl-shadow-md);
}

.benefit > span {
    display: grid;
    place-items: center;
    width: 66px;
    height: 66px;
    margin: 0 auto 20px;
    border-radius: 50%;
    background: var(--gl-sage-light);
    font-size: 26px;
    filter: none !important;
}

.benefit h3 {
    color: var(--gl-forest) !important;
    font-size: 22px;
}

.benefit p {
    color: var(--gl-muted) !important;
    font-size: 12.5px;
    line-height: 1.7;
}

/* ---------------------------------------------------------
   13. FOOTER
   --------------------------------------------------------- */
.footer {
    background: linear-gradient(180deg, #1b3325 0%, #14261c 100%) !important;
    padding: 82px 8% 26px;
    border-top: 1px solid rgba(247, 243, 233, 0.08);
}

.footer-top {
    gap: 42px;
    padding-bottom: 60px;
}

.footer-logo,
.footer-logo span {
    color: var(--gl-on-deep) !important;
}

.footer-logo span {
    color: #cfdcb6 !important;
}

.footer-top p {
    color: #b6c2aa !important;
    font-size: 12px;
    line-height: 1.9;
}

.footer-top h4 {
    color: #e9e3d2;
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 22px;
}

.footer-top > div > a:not(.logo) {
    color: #b6c2aa !important;
    font-size: 12px;
    margin: 13px 0;
}

.footer-top > div > a:not(.logo):hover {
    color: #f7f3e9 !important;
    transform: translateX(6px);
}

.footer-bottom {
    border-top: 1px solid rgba(247, 243, 233, 0.14);
    color: #9fae94 !important;
    font-size: 9.5px;
    letter-spacing: 0.14em;
}

/* ---------------------------------------------------------
   14. PRODUCT MODAL
   --------------------------------------------------------- */
.modal-backdrop {
    background: rgba(14, 30, 21, 0.55) !important;
    backdrop-filter: blur(7px);
    -webkit-backdrop-filter: blur(7px);
}

.product-modal {
    background: var(--gl-paper) !important;
    border-radius: 26px !important;
    border: 1px solid rgba(247, 243, 233, 0.4);
    box-shadow: 0 40px 100px rgba(9, 22, 14, 0.35);
}

.modal-image {
    background: var(--gl-sand) !important;
}

.modal-info {
    padding: 58px 38px 38px;
}

.modal-info h2 {
    color: var(--gl-forest) !important;
}

.modal-price {
    color: var(--gl-forest) !important;
    font-family: "Playfair Display", serif;
}

.modal-info > p:not(.eyebrow):not(.modal-price) {
    color: var(--gl-muted) !important;
}

.plant-details div {
    background: var(--gl-sage-light) !important;
    color: var(--gl-forest) !important;
    border-radius: 14px !important;
}

.plant-details strong {
    color: var(--gl-forest);
}

.plant-details small {
    color: var(--gl-muted) !important;
}

.modal-close {
    color: var(--gl-forest) !important;
    font-size: 26px;
    line-height: 1;
    transition: transform 0.25s var(--gl-ease), color 0.25s;
}

.modal-close:hover {
    transform: rotate(90deg);
    color: var(--gl-terracotta) !important;
}

/* ---------------------------------------------------------
   15. CART DRAWER
   --------------------------------------------------------- */
.drawer-backdrop {
    background: rgba(14, 30, 21, 0.5);
    backdrop-filter: blur(4px);
}

.cart-drawer {
    width: min(440px, 100%);
    padding: 30px;
    background: var(--gl-paper) !important;
    color: var(--gl-ink) !important;
    box-shadow: -30px 0 90px rgba(9, 22, 14, 0.28);
}

.drawer-header {
    border-color: var(--gl-line) !important;
}

.drawer-header h2 {
    color: var(--gl-forest) !important;
}

.cart-items {
    padding-right: 4px;
}

.cart-item {
    grid-template-columns: 76px 1fr auto;
    gap: 14px;
    border-color: var(--gl-line) !important;
    padding: 18px 0;
}

.cart-item img {
    height: 76px;
    border-radius: 12px;
    object-fit: cover;
}

.cart-item h4 {
    color: var(--gl-forest) !important;
    font-size: 13px;
}

.cart-item p {
    color: var(--gl-muted) !important;
}

.cart-item .remove-cart-item {
    background: transparent;
    border: 0;
    color: var(--gl-terracotta) !important;
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 0;
}

.cart-item .remove-cart-item:hover {
    text-decoration: underline;
}

.quantity-control {
    display: inline-flex;
    align-items: center;
    margin-top: 8px;
    border: 1px solid var(--gl-line);
    border-radius: 999px;
    overflow: hidden;
}

.cart-item .quantity-control button {
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--gl-forest);
    font-size: 15px;
    line-height: 1;
    display: grid;
    place-items: center;
    transition: background 0.2s;
}

.cart-item .quantity-control button:hover {
    background: var(--gl-sage-light);
}

.quantity-control span {
    min-width: 28px;
    text-align: center;
    font-size: 12px;
    font-weight: 600;
    color: var(--gl-forest);
}

.cart-footer {
    border-color: var(--gl-line) !important;
    padding-top: 22px;
}

.cart-total {
    align-items: center;
}

.cart-total span {
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gl-muted);
}

.cart-total strong {
    color: var(--gl-forest) !important;
    font-family: "Playfair Display", serif;
    font-size: 24px;
}

.cart-footer .muted {
    color: var(--gl-muted) !important;
    font-size: 10px;
}

/* ---------------------------------------------------------
   16. CHECKOUT
   --------------------------------------------------------- */
.checkout-modal {
    position: relative;
    width: min(1040px, 100%);
    max-height: 92vh;
    overflow: auto;
    padding: 46px;
    border-radius: 26px;
    background: var(--gl-paper);
    box-shadow: 0 40px 110px rgba(9, 22, 14, 0.4);
    animation: modalIn 0.45s var(--gl-ease);
}

.checkout-header h2 {
    color: var(--gl-forest);
    font-size: clamp(30px, 3.3vw, 44px);
    margin-bottom: 8px;
}

.checkout-header > p:not(.eyebrow) {
    color: var(--gl-muted);
    font-size: 12.5px;
}

.checkout-layout {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: 42px;
    margin-top: 32px;
}

.checkout-form fieldset {
    border: 0;
    padding: 0;
    margin: 0 0 26px;
}

.checkout-form legend {
    padding: 0;
    margin-bottom: 16px;
    font-family: "Playfair Display", serif;
    font-size: 19px;
    color: var(--gl-forest);
}

.checkout-field {
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin-bottom: 14px;
}

.checkout-field label {
    font-size: 9.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--gl-muted);
}

.checkout-field input {
    height: 46px;
    padding: 0 16px;
    border: 1px solid var(--gl-line);
    border-radius: 12px;
    background: var(--gl-ivory);
    color: var(--gl-ink);
    font-size: 13px;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
}

.checkout-field input::placeholder {
    color: #9aa394;
}

.checkout-field input:focus {
    border-color: var(--gl-moss);
    box-shadow: 0 0 0 3px rgba(111, 139, 95, 0.16);
}

.checkout-field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
}

.payment-options {
    display: grid;
    gap: 10px;
}

.payment-option {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 15px 16px;
    border: 1px solid var(--gl-line);
    border-radius: 14px;
    background: var(--gl-ivory);
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
}

.payment-option:hover {
    border-color: var(--gl-sage);
}

.payment-option:has(input:checked) {
    border-color: var(--gl-moss);
    background: var(--gl-sage-light);
}

.payment-option input {
    margin-top: 3px;
    accent-color: var(--gl-deep);
}

.payment-option strong {
    display: block;
    font-size: 12.5px;
    color: var(--gl-forest);
}

.payment-option small {
    display: block;
    margin-top: 3px;
    font-size: 10.5px;
    color: var(--gl-muted);
}

.upi-fields {
    margin-top: 14px;
}

.checkout-note {
    margin-top: 12px;
    text-align: center;
    font-size: 10px;
    color: var(--gl-muted);
}

.checkout-summary {
    align-self: start;
    padding: 24px;
    border: 1px solid var(--gl-line);
    border-radius: 18px;
    background: var(--gl-sand);
}

.checkout-summary h3 {
    color: var(--gl-forest);
    font-size: 20px;
    margin-bottom: 14px;
}

.checkout-product-row {
    display: grid;
    grid-template-columns: 54px 1fr auto;
    gap: 12px;
    align-items: center;
    padding: 11px 0;
    border-bottom: 1px solid var(--gl-line);
}

.checkout-product-row img {
    width: 54px;
    height: 54px;
    border-radius: 10px;
    object-fit: cover;
}

.checkout-product-copy strong {
    display: block;
    font-size: 12px;
    color: var(--gl-forest);
}

.checkout-product-copy span {
    font-size: 10px;
    color: var(--gl-muted);
}

.checkout-product-row > strong {
    font-size: 12px;
    color: var(--gl-forest);
}

.checkout-total {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 16px;
    margin-top: 6px;
    border-top: 1px solid var(--gl-line);
}

.checkout-total span {
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gl-muted);
}

.checkout-total strong {
    font-family: "Playfair Display", serif;
    font-size: 23px;
    color: var(--gl-forest);
}

/* Success + tracking views */
.order-view {
    max-width: 640px;
    margin: 0 auto;
    padding: 10px 0;
    text-align: center;
}

.order-badge {
    display: grid;
    place-items: center;
    width: 66px;
    height: 66px;
    margin: 0 auto 20px;
    border-radius: 50%;
    background: var(--gl-sage-light);
    color: var(--gl-forest);
    font-size: 26px;
}

.order-view h2 {
    color: var(--gl-forest);
    font-size: clamp(28px, 3.2vw, 40px);
    margin-bottom: 12px;
}

.order-view > p:not(.eyebrow) {
    color: var(--gl-muted);
    font-size: 13px;
    line-height: 1.8;
}

.order-facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin: 28px 0;
}

.order-facts div {
    padding: 16px 10px;
    border: 1px solid var(--gl-line);
    border-radius: 14px;
    background: var(--gl-sand);
}

.order-facts span {
    display: block;
    margin-bottom: 6px;
    font-size: 8.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gl-muted);
}

.order-facts strong {
    font-size: 13px;
    color: var(--gl-forest);
}

.order-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 24px;
}

.tracking-address {
    color: var(--gl-muted);
    font-size: 12px;
    line-height: 1.7;
}

.tracking-address strong,
.tracking-address span {
    display: block;
}

.tracking-address strong {
    color: var(--gl-forest);
}

.tracking-timeline {
    margin: 26px 0;
    text-align: left;
}

.tracking-step {
    display: grid;
    grid-template-columns: 34px 1fr auto;
    gap: 14px;
    align-items: start;
    padding: 14px 0;
    border-bottom: 1px solid var(--gl-line);
}

.tracking-dot {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 1px solid var(--gl-line);
    border-radius: 50%;
    font-size: 12px;
    color: var(--gl-muted);
}

.tracking-step.active .tracking-dot {
    background: var(--gl-deep);
    border-color: var(--gl-deep);
    color: var(--gl-on-deep);
}

.tracking-step strong {
    font-size: 12.5px;
    color: var(--gl-forest);
}

.tracking-step p {
    margin-top: 3px;
    font-size: 11px;
    color: var(--gl-muted);
}

.tracking-step small {
    font-size: 8.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gl-moss);
}

/* ---------------------------------------------------------
   17. TOAST / BACK TO TOP / LOADER
   --------------------------------------------------------- */
.toast {
    padding: 14px 24px;
    border-radius: 999px !important;
    background: var(--gl-deep) !important;
    color: var(--gl-on-deep) !important;
    border: 1px solid rgba(247, 243, 233, 0.14);
    font-size: 11.5px;
    letter-spacing: 0.03em;
    box-shadow: var(--gl-shadow-md);
}

.back-to-top {
    background: var(--gl-deep) !important;
    color: var(--gl-on-deep) !important;
    box-shadow: 0 10px 26px rgba(31, 58, 43, 0.28);
}

.back-to-top:hover {
    background: var(--gl-deep-soft) !important;
}

.page-loader {
    background: #14261c;
}

.loader-line span {
    background: #cfdcb6;
}

.ambient-orb {
    opacity: 0.1;
    background: #8fa77c;
}

.orb-two {
    background: #c2a26a;
}

/* ---------------------------------------------------------
   18. MOTION
   --------------------------------------------------------- */
@keyframes glCardIn {
    from {
        transform: translateY(22px);
    }
    to {
        transform: translateY(0);
    }
}

/* Gentle stagger for revealed grids */
.dashboard-grid > .reveal:nth-child(2) { transition-delay: 0.08s; }
.dashboard-grid > .reveal:nth-child(3) { transition-delay: 0.16s; }
.dashboard-grid > .reveal:nth-child(4) { transition-delay: 0.24s; }

.benefits-section > .reveal:nth-child(2) { transition-delay: 0.08s; }
.benefits-section > .reveal:nth-child(3) { transition-delay: 0.16s; }

/* ---------------------------------------------------------
   19. RESPONSIVE
   --------------------------------------------------------- */
@media (max-width: 1250px) {
    .hero-green-card {
        display: none;
    }
}

@media (max-width: 1100px) {
    .product-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .section-padding {
        padding: 92px 6%;
    }

    .navbar {
        padding: 0 5%;
    }
}

@media (max-width: 1000px) {
    /* The inline nav only has room for a smaller gap before it collapses. */
    .nav-links {
        gap: 18px;
    }

    .nav-links a {
        font-size: 11px;
    }
}

@media (max-width: 980px) {
    .studio-3d-panel {
        height: auto !important;
        min-height: 700px !important;
        padding: 34px !important;
        display: block !important;
    }

    .studio-3d-copy {
        position: relative !important;
        left: auto !important;
        top: auto !important;
        width: 100% !important;
        max-width: 560px;
    }

    .studio-3d-copy h3.modern-studio-heading {
        font-size: 36px !important;
        margin-bottom: 92px !important;
    }

    .studio-3d-copy .calligraphy-flourish {
        width: 300px !important;
        height: 70px !important;
        top: 78px !important;
        left: 8px !important;
    }

    .studio-3d-viewer {
        position: absolute !important;
        inset: auto 0 96px 0 !important;
        width: 100% !important;
        height: 400px !important;
    }

    .plant-viewer-controls {
        top: auto !important;
        right: 24px !important;
        bottom: 26px !important;
        flex-direction: row !important;
    }

    .plant-viewer-controls button {
        min-width: 0 !important;
        padding: 12px 18px !important;
        font-size: 11px !important;
    }

    .checkout-layout {
        grid-template-columns: 1fr;
        gap: 28px;
    }

    .checkout-summary {
        order: -1;
    }
}

@media (max-width: 820px) {
    .product-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .dashboard-grid {
        grid-template-columns: 1fr;
    }

    .benefits-section {
        grid-template-columns: 1fr;
    }

    .footer-top {
        grid-template-columns: repeat(2, 1fr);
    }

    .studio-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 760px) {
    html {
        scroll-padding-top: 82px;
    }

    .navbar {
        height: 70px;
    }

    .nav-links {
        display: none;
        position: absolute;
        top: 70px;
        left: 0;
        right: 0;
        flex-direction: column;
        align-items: flex-start;
        background: rgba(247, 243, 233, 0.98) !important;
        border-bottom: 1px solid var(--gl-line);
        padding: 22px 7%;
        gap: 4px;
        box-shadow: 0 22px 40px rgba(31, 58, 43, 0.08);
    }

    .nav-links.show {
        display: flex;
    }

    .menu-toggle {
        display: block;
    }

    .nav-links a {
        width: 100%;
        padding: 12px 0;
        font-size: 13px;
    }

    .section-padding {
        padding: 70px 6%;
    }

    .hero {
        min-height: 640px;
        padding: 0 7%;
    }

    .hero h1 {
        font-size: 50px;
    }

    .hero-description {
        font-size: 14px;
    }

    .section-heading {
        align-items: flex-start;
        flex-direction: column;
        gap: 16px;
    }

    .section-heading > p {
        max-width: 100%;
    }

    .intro {
        padding-top: 70px;
        padding-bottom: 70px;
    }

    .studio-main {
        height: 380px;
    }

    .studio-card-content {
        left: 24px;
        bottom: 26px;
    }

    .studio-card-content h3 {
        font-size: 29px;
    }

    .product-grid {
        gap: 14px;
    }

    .product-info {
        padding: 14px 14px 16px;
    }

    .product-info h3 {
        font-size: 17px;
    }

    .product-description {
        font-size: 10.5px;
    }

    .product-price {
        font-size: 17px;
    }

    .delivery-note {
        font-size: 8px;
    }

    .product-actions {
        grid-template-columns: 1fr;
    }

    .add-cart-btn,
    .buy-now-btn {
        padding: 10px 8px;
        font-size: 9px;
    }

    .passport-image {
        height: 320px;
    }

    .product-modal {
        grid-template-columns: 1fr;
    }

    .modal-info {
        padding: 30px 24px;
    }

    .checkout-modal {
        padding: 28px 20px;
        border-radius: 20px;
    }

    .checkout-field-row {
        grid-template-columns: 1fr;
        gap: 0;
    }

    .order-facts {
        grid-template-columns: 1fr;
    }

    .footer {
        padding-top: 64px;
    }

    .footer-bottom {
        flex-direction: column;
        gap: 12px;
    }
}

@media (max-width: 560px) {
    .product-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .product-image-wrap {
