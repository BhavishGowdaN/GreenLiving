/* ---------------------------------------------------------
   21. REDUCED MOTION
   --------------------------------------------------------- */
@media (prefers-reduced-motion: reduce) {
    .product-card {
        animation: none;
    }

    .reveal {
        opacity: 1;
        transform: none;
    }

    *,
    *::before,
    *::after {
        scroll-behavior: auto !important;
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
    }
}

/* ---------------------------------------------------------
   22. COMMERCE UPGRADES
   --------------------------------------------------------- */
.product-actions {
    grid-template-columns: 1fr;
}

.add-cart-btn,
.buy-now-btn {
    width: 100%;
}

.modal-actions {
    display: grid;
    gap: 10px;
    margin-top: 18px;
}

.modal-actions .btn {
    width: 100%;
}

.checkout-product-row {
    grid-template-columns: 54px minmax(0, 1fr) auto;
    align-items: start;
}

.checkout-product-copy span {
    display: block;
    margin-top: 3px;
}

.checkout-qty {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
    padding: 3px 6px;
    border: 1px solid var(--gl-line);
    border-radius: 999px;
    background: var(--gl-paper);
}

.checkout-qty button {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--gl-sage-light);
    color: var(--gl-forest);
    font: inherit;
    font-size: 13px;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s var(--gl-ease), color 0.2s var(--gl-ease);
}

.checkout-qty button:hover {
    background: var(--gl-moss);
    color: var(--gl-on-deep);
}

.checkout-qty > span {
    min-width: 16px;
    margin: 0;
    text-align: center;
    font-size: 11px;
    color: var(--gl-forest);
}

.checkout-line-total {
    align-self: center;
}

.checkout-breakdown {
    display: grid;
    gap: 8px;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--gl-line);
}

.checkout-breakdown div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-size: 11px;
    color: var(--gl-muted);
}

.checkout-breakdown strong {
    font-size: 11.5px;
    color: var(--gl-forest);
}

.order-items,
.tracking-items {
    display: grid;
    gap: 8px;
    margin: 20px 0;
    text-align: left;
}

.order-item {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) auto;
    gap: 12px;
    align-items: center;
    padding: 10px 12px;
    border: 1px solid var(--gl-line);
    border-radius: 12px;
    background: var(--gl-sand);
}

.order-item img {
    width: 44px;
    height: 44px;
    border-radius: 8px;
    object-fit: cover;
}

.order-item-copy strong {
    display: block;
    font-size: 11.5px;
    color: var(--gl-forest);
}

.order-item-copy span {
    display: block;
    margin-top: 2px;
    font-size: 10px;
    color: var(--gl-muted);
}

.order-item > strong {
    font-size: 11.5px;
    color: var(--gl-forest);
}

.order-item.compact {
    padding: 8px 10px;
}

.order-breakdown {
    display: grid;
    gap: 8px;
    max-width: 420px;
    margin: 0 auto 8px;
    text-align: left;
}

.order-breakdown div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-size: 11.5px;
    color: var(--gl-muted);
}

.order-breakdown strong {
    color: var(--gl-forest);
}

.order-breakdown-total {
    padding-top: 10px;
    border-top: 1px solid var(--gl-line);
}

.order-breakdown-total span {
    color: var(--gl-forest);
    font-weight: 600;
}

.order-breakdown-total strong {
    font-family: "Playfair Display", serif;
    font-size: 20px;
}

.tracking-eta {
    margin: 6px 0 12px;
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--gl-moss);
}

.tracking-progress {
    height: 6px;
    margin: 12px 0 8px;
    overflow: hidden;
    border-radius: 999px;
    background: var(--gl-sage-light);
}

.tracking-progress span {
    display: block;
    width: 0;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--gl-moss), var(--gl-deep));
    transition: width 0.6s var(--gl-ease);
}

.tracking-step.completed .tracking-dot {
    background: var(--gl-sage-light);
    border-color: var(--gl-moss);
    color: var(--gl-forest);
}

.tracking-step.completed small {
    color: var(--gl-moss);
}

.tracking-step.active .tracking-dot {
    background: var(--gl-deep);
    border-color: var(--gl-deep);
    color: var(--gl-on-deep);
    box-shadow: 0 0 0 4px rgba(111, 139, 95, 0.16);
}

.tracking-step.pending {
    opacity: 0.55;
}

.tracking-step.pending .tracking-dot {
    background: transparent;
}

body.dark-mode .checkout-qty,
body.dark-mode .order-item {
    background: var(--gl-sand);
}

/* ---------------------------------------------------------
   23. 3D STUDIO TOOLBAR
   --------------------------------------------------------- */
.studio-toolbar {
    position: absolute;
    left: 50%;
    bottom: 22px;
    z-index: 9;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: max-content;
    max-width: calc(100% - 40px);
    padding: 8px 10px;
    border: 1px solid rgba(247, 243, 233, 0.18);
    border-radius: 18px;
    background: rgba(15, 30, 21, 0.68);
    box-shadow: 0 16px 40px rgba(9, 20, 14, 0.28);
    backdrop-filter: blur(16px);
    transform: translateX(-50%);
}

.studio-toolbar-group {
    display: flex;
    align-items: center;
    gap: 6px;
}

.studio-toolbar-label {
    margin-right: 2px;
    font-size: 8.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    color: #cfdcb6;
}

.studio-tool {
    padding: 8px 12px;
    border: 1px solid rgba(247, 243, 233, 0.22);
    border-radius: 999px;
    background: rgba(247, 243, 233, 0.08);
    color: #f4f1e5;
    font: inherit;
    font-size: 10px;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition:
        background 0.25s var(--gl-ease),
        transform 0.25s var(--gl-ease),
        opacity 0.25s var(--gl-ease);
}

.studio-tool:hover {
    background: rgba(247, 243, 233, 0.18);
    transform: translateY(-1px);
}

.studio-tool.plant-tool::before {
    content: "＋";
    margin-right: 5px;
    color: #cfdcb6;
}

.studio-tool.icon-tool {
    min-width: 32px;
    padding: 8px 10px;
    font-size: 13px;
    line-height: 1;
}

.studio-tool.mode-tool {
    border-color: transparent;
    background: #e9e3d2;
    color: #1f3a2b;
    font-weight: 700;
}

.studio-tool.mode-tool[aria-pressed="true"] {
    background: #cfdcb6;
}

.studio-tool.is-disabled {
    opacity: 0.4;
    cursor: not-allowed;
}

.studio-toolbar-actions {
    padding-left: 8px;
    border-left: 1px solid rgba(247, 243, 233, 0.16);
}

.studio-hint {
    position: absolute;
    left: 50%;
    bottom: 82px;
    z-index: 8;
    width: max-content;
    max-width: calc(100% - 40px);
    margin: 0;
    color: rgba(240, 243, 232, 0.66);
    font-size: 9.5px;
    letter-spacing: 0.04em;
    text-align: center;
    pointer-events: none;
    transform: translateX(-50%);
}

@media (max-width: 1100px) {
    .studio-toolbar {
        bottom: 16px;
        gap: 6px;
        padding: 7px 8px;
    }

    .studio-tool {
        padding: 7px 10px;
        font-size: 9.5px;
    }
}

@media (max-width: 850px) {
    .studio-toolbar {
        width: calc(100% - 32px);
        max-width: 560px;
        flex-direction: column;
        align-items: stretch;
    }

    .studio-toolbar-group {
        justify-content: center;
        flex-wrap: wrap;
    }

    .studio-toolbar-actions {
        padding-top: 6px;
        padding-left: 0;
        border-top: 1px solid rgba(247, 243, 233, 0.16);
        border-left: 0;
    }

    .studio-hint {
        bottom: 128px;
    }
}

@media (max-width: 560px) {
    .studio-toolbar {
        bottom: 10px;
        width: calc(100% - 20px);
        padding: 6px;
        gap: 4px;
    }

    .studio-toolbar-label {
        display: none;
    }

    .studio-tool {
        padding: 6px 9px;
        font-size: 9px;
    }

    .studio-tool.icon-tool {
        min-width: 28px;
        padding: 6px 8px;
    }

    .studio-toolbar-actions {
        padding-top: 4px;
    }

    .studio-hint {
        display: none;
    }

    .plant-viewer-controls {
        bottom: 118px !important;
        right: 10px !important;
    }

    .plant-viewer-controls button {
