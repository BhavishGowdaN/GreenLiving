#shop .product-card{display:flex!important;flex-direction:column!important;min-width:0;border-radius:15px!important;background:#fffdf7!important;border:1px solid #e2e5d8!important;box-shadow:0 5px 16px rgba(31,63,37,.08)!important}
#shop .product-image-wrap{height:clamp(170px,17vw,235px)!important;aspect-ratio:4/3!important;background:#f2f0e5!important}
#shop .product-image-wrap>img.product-image,#shop .product-image-wrap>img.product-image--lifestyle,#shop .product-image-wrap>img.product-image--catalog{width:100%;height:100%;object-fit:contain!important;padding:5px!important}
#shop .product-info{padding:11px 12px 13px!important;gap:5px!important}
#shop .product-title-open,#shop .product-info h3{font:700 clamp(15px,1.15vw,19px)/1.25 var(--gl-section-font)!important;color:#113c23!important;margin:0!important}
#shop .product-description{font-size:11px!important;line-height:1.48!important;color:#35483a!important;min-height:2.9em}
#shop .product-rating{font-size:11px!important}.rating-stars{font-size:13px!important}
#shop .product-price{font-size:18px!important;color:#0c4527!important}.product-original-price{font-size:11px!important}
#shop .product-discount{font-size:10px!important;padding:4px 7px!important}
#shop .product-actions{display:flex!important;gap:6px!important;flex-wrap:nowrap!important;margin-top:6px!important}
#shop .product-actions button{font-size:10px!important;min-height:34px!important;padding:6px 7px!important;border-radius:8px!important;white-space:nowrap}
#customize.customizer-section{padding:40px clamp(16px,5vw,78px) 58px;background:linear-gradient(rgba(247,246,232,.82),rgba(247,246,232,.9)),url('assets/products/photography/home-botanical-interior.png') center/cover fixed!important}
#customize .customizer-page-heading{display:flex;align-items:center;justify-content:center;text-align:center;gap:15px;margin:0 auto 24px;max-width:1000px}
#customize .customizer-page-heading h2{font:700 clamp(34px,3.6vw,48px)/1.12 var(--gl-heading-font)!important;color:#073b20!important;margin:0}
#customize .customizer-intro{font-size:13px!important;color:#364b39!important;max-width:760px;margin:8px auto 0}
#customize .customizer-layout{display:block!important;max-width:1180px!important;margin:0 auto!important}
#customize .customizer-form{display:flex;flex-direction:column;gap:18px;padding:24px clamp(18px,3vw,38px)!important;background:rgba(255,254,246,.95)!important;border:1px solid #d9e0ce!important;border-radius:20px!important;box-shadow:0 12px 32px rgba(27,57,32,.10)!important}
#customize .customizer-form-title{display:flex;align-items:center;gap:12px;margin:0 0 2px}
#customize .customizer-form-title>span{font-size:34px;color:#5d982d}
#customize .customizer-form-title h3{font:700 23px/1.25 var(--gl-section-font)!important;color:#0d3d22!important;margin:0}
#customize .customizer-field-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px 22px}
#customize .customizer-field-grid label,#customize .customizer-full-field{display:flex;flex-direction:column;gap:7px;color:#173523!important;font-size:13px!important;font-weight:650;min-width:0}
#customize .customizer-field-grid select,#customize .customizer-field-grid input,#customize .customizer-full-field textarea{width:100%;min-height:44px;border:1px solid #ccd5c6;border-radius:10px;background:#fffefa;color:#1c3023;padding:10px 13px;font-size:13px!important;font-weight:500}
#customize .customizer-full-field{margin-top:0}.customizer-field-grid .customizer-full-field{grid-column:1/-1}
#customize .customizer-full-field textarea{min-height:78px;resize:vertical}
#customize .custom-plant-care-block,#customize .customizer-design-summary{padding:17px 18px;background:#f7f8ed;border:1px solid #e0e8d5;border-radius:15px}
#customize .custom-info-heading{display:flex;align-items:center;gap:10px;margin-bottom:12px}
#customize .custom-info-heading>span{font-size:27px;color:#62983b}
#customize .custom-info-heading .eyebrow{font-size:9px;letter-spacing:1.5px;color:#719054;margin:0}
#customize .custom-info-heading h3{font:700 19px/1.3 var(--gl-section-font)!important;color:#103f25;margin:0}
#customize .custom-plant-care-info{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;padding:0;background:transparent;border:0;margin:0}
#customize .custom-plant-care-info>div{padding:9px 11px;border:0;border-left:1px solid #dce5d3;display:flex;flex-direction:column;gap:3px}
#customize .custom-plant-care-info b{font-size:10px;color:#63804c;text-transform:uppercase;letter-spacing:.06em}
#customize .custom-plant-care-info span{font-size:12px;color:#263d2d;line-height:1.45}
#customize .customizer-design-summary #customDesignDetails{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 20px;margin:0}
#customize #customDesignDetails>div{display:grid;grid-template-columns:minmax(95px,.7fr) minmax(0,1.3fr);gap:8px;padding:7px 0;border-bottom:1px solid #e4e9dc;min-width:0}
#customize #customDesignDetails dt{font-size:11px;font-weight:650;color:#607750}
#customize #customDesignDetails dd{font-size:12px;color:#203829;margin:0;overflow-wrap:anywhere}
#customize .pot-text-live-preview{margin-top:14px;padding:11px 14px;border-radius:10px;background:#fffefa;border:1px dashed #cbd5bd}
#customize .pot-text-live-preview>span{font-size:9px;letter-spacing:1.2px;color:#6f8b55;font-weight:700}
#customize .pot-text-live-preview strong{font:600 italic 20px var(--gl-section-font);color:#214a2e;display:block;margin-top:3px;overflow-wrap:anywhere}
#customize .gift-options{padding:14px;border-radius:13px;background:#f2f4e8;border:1px solid #dce5d3}
#customize .gift-options h4{font:700 18px var(--gl-section-font);color:#154328}
#customize .customizer-price-line{display:flex;justify-content:space-between;align-items:center;gap:12px;margin:0;padding:13px 16px;background:#eaf2dc;border-radius:12px}
#customize .customizer-price-line span{font-size:12px;color:#496a3e;font-weight:650}
#customize .customizer-price-line strong{font-size:24px;color:#123d24}
#customize .customizer-price-line small{font-size:10px;color:#61745a}
#customize .customizer-form-actions{display:grid;grid-template-columns:1.3fr .7fr;gap:10px}
#customize .customizer-form-actions button{min-height:46px;border-radius:999px;font-size:12px;font-weight:700}
#customize .customizer-privacy-note{font-size:10px;color:#6a7968;margin:0}
