body.dark-mode #customize .customizer-intro,body.dark-mode #customize .customizer-field-grid label,body.dark-mode #customize .customizer-full-field{color:#e9efe2!important}
body.dark-mode #customize .customizer-field-grid input,body.dark-mode #customize .customizer-field-grid select,body.dark-mode #customize .customizer-full-field textarea{background:#10291b!important;color:#f4f1e8!important;border-color:#54715a!important}
body.dark-mode #customize .custom-plant-care-block,body.dark-mode #customize .customizer-design-summary,body.dark-mode #customize .gift-options{background:#203e2c!important;border-color:#49644d!important}
body.dark-mode #customize .custom-plant-care-info b,body.dark-mode #customize .custom-plant-care-info span,body.dark-mode #customize #customDesignDetails dt,body.dark-mode #customize #customDesignDetails dd{color:#e8efe1!important}
body.dark-mode #customize #customDesignDetails>div{border-color:#456149}
body.dark-mode #customize .pot-text-live-preview{background:#142d1e;border-color:#54705a}
body.dark-mode #customize .pot-text-live-preview strong{color:#e7f0dd}
body.dark-mode #customize .customizer-price-line{background:#34533a}
body.dark-mode #customize .customizer-price-line span,body.dark-mode #customize .customizer-price-line small{color:#dbe8d2}
body.dark-mode #customize .customizer-price-line strong{color:#fff8e8}
@media(max-width:1000px){#shop .shop-product-grid{grid-template-columns:repeat(3,minmax(0,1fr))!important}.nav-links{gap:6px}.nav-links a{font-size:11px;padding:8px}}
@media(max-width:760px){.navbar{height:auto;min-height:62px;padding:8px 14px}.nav-links{gap:3px}.nav-links a{font-size:10px;padding:7px 8px}.hero#home{height:auto;min-height:620px}.hero-content{margin:60px 18px 50px;padding:25px 22px}.hero h1{font-size:clamp(40px,10vw,58px)!important}#shop .shop-product-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}#shop .product-image-wrap{height:clamp(145px,36vw,205px)!important}#dashboard .dashboard-grid{grid-template-columns:1fr}#customize .customizer-field-grid{grid-template-columns:1fr}#customize .customizer-form-actions{grid-template-columns:1fr}#customize .custom-plant-care-info{grid-template-columns:repeat(2,minmax(0,1fr))}#customize #customDesignDetails{grid-template-columns:1fr}}
@media(max-width:480px){.logo{font-size:19px!important}.logo-emblem{width:30px;height:30px}.nav-actions{gap:4px}.icon-btn{font-size:16px!important}.hero-content{margin:45px 12px;padding:21px 18px}.hero-description{font-size:13px}#shop .product-actions{flex-direction:column!important}#shop .product-actions button{width:100%}#customize .customizer-form{padding:18px 14px!important}#customize .customizer-page-heading h2{font-size:31px!important}}
/* Selected plant profile below the full-width customization form. */
#customize .custom-selected-plant{display:grid;grid-template-columns:116px minmax(0,1fr);gap:15px;align-items:center}
#customize .custom-selected-plant>img{width:116px;height:128px;object-fit:contain;background:#eef2e6;border-radius:12px;padding:7px}
#customize .custom-selected-plant>div>strong{display:block;color:#173f27;font:700 18px var(--gl-section-font);margin:0 0 8px}
#customize .custom-plant-care-info{grid-template-columns:repeat(2,minmax(0,1fr))}
#studio{background:linear-gradient(rgba(248,247,235,.88),rgba(248,247,235,.93)),url('assets/products/photography/home-botanical-interior.png') center/cover fixed!important}
#care{background:linear-gradient(rgba(248,247,235,.86),rgba(248,247,235,.93)),url('assets/products/photography/shop-hero-plants.png') center/cover fixed!important}
#studio .anatomy-card,#studio .botanical-photo-stage,#studio .botanical-detail-below,#care .passport-content{border-radius:18px}
