body.dark-mode .intro,
body.dark-mode .dashboard-section,
body.dark-mode .benefits-section {
    background: #071323 !important;
}

body.dark-mode .studio-section {
    background: linear-gradient(180deg, #102C21 0%, #071323 100%) !important;
}

body.dark-mode .shop-section {
    background: linear-gradient(180deg, #102C21 0%, #071323 100%) !important;
}

body.dark-mode .passport-section {
    background: #102C21 !important;
}

body.dark-mode .product-card,
body.dark-mode .dashboard-card,
body.dark-mode .benefit,
body.dark-mode .space-option,
body.dark-mode .checkout-modal,
body.dark-mode .product-modal,
body.dark-mode .cart-drawer {
    background: #173D2B !important;
}

/* --- 25.4 BloomSpace neon neutralizer ---
   Counter every remaining hardcoded #A8F044 / #B9F65C / #73D32F
   rule from styles.css (loaded before this file). */
.nav-links a::after {
    background: var(--gl-gold);
}

.cart-button span {
    background: var(--gl-terracotta);
    color: #F8F4EA;
}

body.dark-mode .cart-button span {
    background: var(--gl-gold);
    color: #071323;
}

.btn-light {
    background: linear-gradient(135deg, var(--gl-forest), var(--gl-deep-soft));
    color: #F8F4EA;
    box-shadow: 0 10px 26px rgba(36, 69, 54, 0.24);
}

body.dark-mode .btn-light {
    background: linear-gradient(135deg, #173D2B, #2F4A3B);
    color: #FFFDF7;
}

.btn-dark,
.btn-solid {
    background: var(--gl-forest);
    color: #F8F4EA;
}

/* scroll progress bar (BloomSpace border-right neon) */
.scroll-progress,
#scrollProgress {
    border-right-color: var(--gl-gold) !important;
    background: linear-gradient(90deg, var(--gl-moss), var(--gl-gold)) !important;
}

/* footer link accents */
body.dark-mode .footer a,
body.dark-mode .footer-links a {
    color: #C5D0C1 !important;
}

/* dark-mode navigation follows the secondary text tone */
body.dark-mode .nav-links a {
    color: #C5D0C1 !important;
}

body.dark-mode .nav-links a:hover,
body.dark-mode .nav-links a.active {
    color: #FFFDF7 !important;
}

/* anything still painted neon by inline BloomSpace rules */
[style*="A8F044"] {
    color: var(--gl-moss) !important;
    background-color: transparent;
}

/* =========================================================
   26. GARDEN STUDIO — CINEMATIC BOTANICAL REDESIGN
   Deep forest gradient + softly blurred foliage photograph,
   gold botanical edge leaves, split-screen layout with the
   architectural 3D preview on the right. The scene itself
   always starts empty (see plant3d.js).
   ========================================================= */

.studio-section {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    color: #F5F1E8;
    background:
        radial-gradient(1100px 520px at 78% -10%, rgba(36, 69, 54, 0.55), transparent 62%),
        radial-gradient(900px 600px at -8% 108%, rgba(16, 60, 67, 0.35), transparent 60%),
        linear-gradient(180deg, #071B12 0%, #102C21 52%, #0B2119 100%) !important;
}

body.dark-mode .studio-section {
    background:
        radial-gradient(1100px 520px at 78% -10%, rgba(36, 69, 54, 0.5), transparent 62%),
        radial-gradient(900px 600px at -8% 108%, rgba(16, 60, 67, 0.3), transparent 60%),
        linear-gradient(180deg, #071B12 0%, #102C21 55%, #071B12 100%) !important;
}

/* --- 26.1 Cinematic botanical backdrop --- */
.studio-backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
}

.studio-backdrop-photo {
    position: absolute;
    inset: -56px;
    background:
        url("https://images.unsplash.com/photo-1416879595882-3373a0480b5b?auto=format&fit=crop&w=1600&q=80")
        center / cover no-repeat;
    filter: blur(16px) saturate(0.92) brightness(0.5);
    transform: scale(1.06);
}

.studio-backdrop-overlay {
    position: absolute;
    inset: 0;
    background:
        linear-gradient(180deg, rgba(7, 27, 18, 0.66) 0%, rgba(7, 27, 18, 0.26) 42%, rgba(7, 27, 18, 0.8) 100%),
        radial-gradient(120% 90% at 50% 42%, transparent 40%, rgba(7, 27, 18, 0.55) 100%);
}

.studio-leaf {
    position: absolute;
    width: 220px;
    height: 220px;
    opacity: 0.85;
    filter: drop-shadow(0 10px 24px rgba(0, 0, 0, 0.35));
}

.studio-leaf--tl { top: -24px; left: -24px; }
.studio-leaf--tr { top: -20px; right: -28px; }
.studio-leaf--bl { bottom: -30px; left: -26px; width: 200px; height: 200px; }
.studio-leaf--br { bottom: -26px; right: -20px; width: 200px; height: 200px; }

/* --- 26.2 Split-screen layout --- */
.studio-split {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(330px, 440px) minmax(0, 1fr);
    gap: clamp(28px, 4vw, 56px);
    align-items: start;
}

/* --- 26.3 Left copy panel (dark translucent overlay behind text) --- */
.studio-copy {
    background: rgba(7, 27, 18, 0.58);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border: 1px solid rgba(185, 154, 98, 0.3);
    border-radius: 26px;
    padding: clamp(26px, 3vw, 40px);
    box-shadow: 0 34px 80px rgba(0, 0, 0, 0.35);
}

.studio-copy .eyebrow {
    color: #C5A66B !important;
    letter-spacing: 3px;
}

.studio-heading {
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(30px, 3.2vw, 44px);
    font-weight: 600;
    line-height: 1.14;
    color: #F5F1E8;
    margin: 10px 0 18px;
}

.studio-heading em {
    color: #C5A66B;
    font-style: italic;
}

.studio-lead {
    color: rgba(245, 241, 232, 0.88);
    font-size: 15.5px;
    line-height: 1.75;
    margin-bottom: 14px;
}

.studio-support {
    color: #A4B39A;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-style: italic;
    font-size: 17.5px;
    margin-bottom: 24px;
}

.studio-section .studio-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #F5F1E8 !important;
    color: #244536 !important;
    font-family: "Manrope", sans-serif;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.14em;
    padding: 15px 32px;
    border-radius: 999px;
    border: 1px solid rgba(197, 166, 107, 0.5);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.35);
    transition: transform 0.35s var(--gl-ease), box-shadow 0.35s var(--gl-ease),
        background 0.35s var(--gl-ease), color 0.35s var(--gl-ease);
}

.studio-section .studio-cta:hover {
    background: #C5A66B !important;
    color: #071B12 !important;
    transform: translateY(-2px);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.4);
}

.studio-controls {
    margin-top: 28px;
    padding-top: 24px;
    border-top: 1px solid rgba(185, 154, 98, 0.22);
}

.studio-controls-label {
    font-family: "Manrope", sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.24em;
    color: #A4B39A;
    margin-bottom: 12px;
}

.studio-chips {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
}

.studio-chips .space-option {
    display: flex;
    align-items: center;
    gap: 10px;
    text-align: left;
    background: rgba(255, 253, 247, 0.05);
    border: 1px solid rgba(185, 154, 98, 0.28);
    border-radius: 14px;
    padding: 12px 14px;
    cursor: pointer;
    transition: background 0.3s var(--gl-ease), border-color 0.3s var(--gl-ease),
        transform 0.3s var(--gl-ease);
}

.studio-chips .space-option:hover {
    background: rgba(130, 150, 92, 0.16);
    border-color: rgba(197, 166, 107, 0.55);
    transform: translateY(-1px);
}

.studio-chips .space-option.active {
    background: rgba(130, 150, 92, 0.22);
    border-color: #C5A66B;
}

.studio-chips .space-icon {
    font-size: 18px;
    color: #C5A66B;
    flex: 0 0 auto;
}

.studio-chips .space-option strong {
    display: block;
    font-family: "Manrope", sans-serif;
    font-size: 13.5px;
    font-weight: 600;
    color: #F5F1E8;
}

.studio-chips .space-option small {
    display: block;
    font-size: 11px;
    color: rgba(245, 241, 232, 0.62);
}

.studio-chips .option-arrow {
    display: none;
}

/* Counter the legacy glass-card .space-option styles (which use
   !important) — the redesigned chips stay translucent on the
   cinematic backdrop in both themes. */
.studio-chips .space-option,
body.dark-mode .studio-chips .space-option {
    background: rgba(255, 253, 247, 0.05) !important;
    border: 1px solid rgba(185, 154, 98, 0.28) !important;
    border-radius: 14px !important;
    color: #F5F1E8 !important;
    box-shadow: none !important;
}

.studio-chips .space-option:hover,
.studio-chips .space-option.active,
body.dark-mode .studio-chips .space-option:hover,
body.dark-mode .studio-chips .space-option.active {
    background: rgba(130, 150, 92, 0.22) !important;
    border-color: #C5A66B !important;
    box-shadow: 0 10px 26px rgba(0, 0, 0, 0.3) !important;
    transform: translateY(-1px) !important;
}

.studio-chips .space-option strong,
body.dark-mode .studio-chips .space-option strong {
    color: #F5F1E8 !important;
}

.studio-chips .space-option small,
body.dark-mode .studio-chips .space-option small {
    color: rgba(245, 241, 232, 0.62) !important;
}

.studio-chips .space-icon,
body.dark-mode .studio-chips .space-icon {
    background: transparent !important;
    color: #C5A66B !important;
    border-radius: 0 !important;
    width: auto;
    height: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

.studio-result {
    margin-top: 12px;
    font-size: 12px;
    color: #A4B39A;
}

.studio-copy .studio-result,
.studio-copy .studio-result strong {
    color: #A4B39A !important;
}

.studio-copy .studio-result strong {
    color: #F5F1E8 !important;
    font-weight: 600;
}

.studio-space-copy {
    margin-top: 8px;
    font-size: 13px;
    line-height: 1.7;
    color: rgba(245, 241, 232, 0.78);
    min-height: 66px;
}

.studio-lighting {
    margin-top: 2px;
    padding-top: 20px;
    border-top: 1px solid rgba(185, 154, 98, 0.22);
}

.studio-lighting-row {
    display: flex;
    gap: 10px;
}

.studio-lighting-copy {
    margin-top: 10px;
    font-size: 12.5px;
    line-height: 1.65;
    color: rgba(245, 241, 232, 0.7);
}

/* --- 26.4 Studio tool chips (shared) --- */
.studio-section .studio-tool {
    font-family: "Manrope", sans-serif;
    font-size: 12px;
    font-weight: 600;
    color: #F5F1E8;
    background: rgba(255, 253, 247, 0.07);
    border: 1px solid rgba(185, 154, 98, 0.3);
    border-radius: 999px;
    padding: 9px 16px;
    cursor: pointer;
    transition: background 0.3s var(--gl-ease), border-color 0.3s var(--gl-ease),
        color 0.3s var(--gl-ease);
}

.studio-section .studio-tool:hover {
    background: rgba(130, 150, 92, 0.22);
    border-color: #C5A66B;
}

.studio-section .mode-tool[aria-pressed="true"] {
    background: #C5A66B;
    border-color: #C5A66B;
    color: #071B12;
}

/* --- 26.5 Right preview panel --- */
.studio-preview {
    min-width: 0;
}

.studio-preview-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
    flex-wrap: wrap;
}

.studio-preview-label {
    font-family: "Manrope", sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.24em;
    color: #A4B39A;
}

.studio-preview-actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}

.studio-3d-viewer {
    position: relative !important;
    inset: auto !important;
    width: auto !important;
    border-radius: 28px;
    overflow: hidden;
    border: 1px solid rgba(197, 166, 107, 0.38);
    box-shadow: 0 40px 90px rgba(0, 0, 0, 0.5);
    background: #E8E0CF;
}

.studio-preview .studio-3d-view {
    width: 100% !important;
    height: clamp(400px, 54vh, 580px) !important;
    cursor: grab;
}

.studio-preview .studio-3d-view:active {
    cursor: grabbing;
}

.studio-3d-viewer .plant-loading {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: rgba(7, 27, 18, 0.82);
    color: #F5F1E8;
    font-family: "Manrope", sans-serif;
    font-size: 12.5px;
    letter-spacing: 0.06em;
    padding: 12px 22px;
    border-radius: 999px;
    border: 1px solid rgba(197, 166, 107, 0.4);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.4);
}

.studio-3d-viewer .plant-error {
    position: absolute;
    left: 50%;
    bottom: 16px;
    transform: translateX(-50%);
    max-width: 90%;
    text-align: center;
    color: #E8C9B4;
    font-size: 12.5px;
}

/* --- 26.6 Minimal toolbar --- */
.studio-toolbar {
    margin-top: 14px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    align-items: center;
    justify-content: space-between;
    background: rgba(7, 27, 18, 0.55);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(185, 154, 98, 0.26);
    border-radius: 18px;
    padding: 12px 16px;
}

.studio-toolbar-group {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
}

.studio-toolbar-label {
    font-family: "Manrope", sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: #A4B39A;
    margin-right: 2px;
}

.studio-section .realistic-tool {
    border-color: rgba(197, 166, 107, 0.6);
    color: #E7D6AE;
}

.studio-section .icon-tool {
    width: 38px;
    height: 38px;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    border-radius: 12px;
}

.studio-section .icon-tool.is-disabled {
    opacity: 0.38;
    cursor: not-allowed;
}

.studio-hint {
    margin-top: 10px;
    text-align: center;
    font-size: 12px;
    color: rgba(245, 241, 232, 0.6);
}

/* --- 26.7 Space inspiration film --- */
.studio-films {
    position: relative;
    z-index: 2;
    margin-top: clamp(40px, 5vw, 64px);
}

.studio-films-label {
    font-family: "Manrope", sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.24em;
    color: #A4B39A;
    margin-bottom: 12px;
}

.studio-films .studio-main {
    position: relative;
    height: clamp(280px, 38vw, 420px);
    border-radius: 26px;
    overflow: hidden;
    border: 1px solid rgba(197, 166, 107, 0.3);
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.45);
}

.studio-films .studio-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.5s var(--gl-ease);
}

.studio-films .studio-video.changing {
    opacity: 0;
}

.studio-films .studio-video-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(7, 27, 18, 0.8) 0%, rgba(7, 27, 18, 0.18) 62%);
}

.studio-films .studio-card-content {
    position: absolute;
    left: clamp(22px, 4vw, 48px);
    bottom: clamp(22px, 4vw, 44px);
    max-width: 480px;
}

.studio-films #studioSubtitle {
    display: block;
    font-family: "Manrope", sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.26em;
    color: #C5A66B;
    margin-bottom: 10px;
}

.studio-films #studioTitle {
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 600;
    line-height: 1.2;
    color: #F5F1E8;
    margin-bottom: 12px;
}

.studio-films .text-link {
    display: inline-block;
    font-family: "Manrope", sans-serif;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #F5F1E8;
    border-bottom: 1px solid rgba(197, 166, 107, 0.6);
    padding-bottom: 3px;
    transition: color 0.3s, border-color 0.3s;
}

.studio-films .text-link:hover {
    color: #C5A66B;
    border-color: #C5A66B;
}

/* --- 26.8 Responsive --- */
@media (max-width: 1080px) {
    .studio-split {
        grid-template-columns: 1fr;
    }

    .studio-preview .studio-3d-view {
        height: clamp(360px, 48vh, 500px) !important;
    }
}

@media (max-width: 640px) {
    .studio-chips {
        grid-template-columns: 1fr;
    }

    .studio-toolbar {
        flex-direction: column;
        align-items: stretch;
    }

    .studio-preview .studio-3d-view {
        height: 340px !important;
    }

    .studio-leaf {
        width: 150px;
        height: 150px;
    }

    .studio-films .studio-main {
        height: 300px;
    }
}

@media (prefers-reduced-motion: reduce) {
    .studio-section .studio-cta,
    .studio-chips .space-option,
    .studio-section .studio-tool {
        transition: none;
    }
}

/* =========================================================
   27. PLANT ANATOMY VIEWER — Sketchfab-style 3D learning mode
   Lives inside the Garden Studio preview panel. Transparent
   Three.js canvas on a soft ivory card; glass labels with
   champagne leader lines; editorial info panel.
   ========================================================= */

.anatomy-viewer[hidden] {
    display: none !important;
}

.anatomy-viewer {
    margin-top: 14px;
}

/* --- 27.1 Mode tabs (Space Designer / Plant Anatomy) --- */
.studio-mode-tabs {
    display: inline-flex;
    gap: 6px;
    background: rgba(7, 27, 18, 0.5);
    border: 1px solid rgba(185, 154, 98, 0.28);
    border-radius: 999px;
    padding: 4px;
}

.studio-mode-tab {
    font-family: "Manrope", sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: rgba(245, 241, 232, 0.75);
    background: transparent;
    border: 0;
    border-radius: 999px;
    padding: 8px 16px;
    cursor: pointer;
    transition: background 0.3s var(--gl-ease), color 0.3s var(--gl-ease);
}

.studio-mode-tab:hover {
    color: #F5F1E8;
}

.studio-mode-tab.active {
    background: #C5A66B;
    color: #071B12;
}

/* --- 27.2 Anatomy head rows --- */
.anatomy-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    margin-bottom: 12px;
}

.anatomy-library,
.anatomy-modes {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
}

.anatomy-library::before {
    content: "PLANT LIBRARY";
    font-family: "Manrope", sans-serif;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.22em;
    color: #A4B39A;
    margin-right: 4px;
}

.anatomy-modes::before {
    content: "VIEW";
    font-family: "Manrope", sans-serif;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.22em;
    color: #A4B39A;
    margin-right: 4px;
}

.studio-section .anatomy-plant {
    font-size: 11.5px;
    padding: 7px 13px;
}

.studio-section .anatomy-plant.active {
    background: rgba(130, 150, 92, 0.35);
    border-color: #C5A66B;
    color: #F5F1E8;
}

.studio-section .anatomy-mode.active {
    background: rgba(130, 150, 92, 0.35);
    border-color: #C5A66B;
    color: #F5F1E8;
}

.anatomy-view-actions {
    display: flex;
    gap: 8px;
    margin-left: auto;
}

/* --- 27.3 Canvas card --- */
.anatomy-canvas-wrap {
    position: relative;
    border-radius: 28px;
    overflow: hidden;
    border: 1px solid rgba(197, 166, 107, 0.38);
    box-shadow: 0 40px 90px rgba(0, 0, 0, 0.5);
    background:
        radial-gradient(120% 90% at 50% 0%, #FFFCF5 0%, #F1EBDC 58%, #E7DFD0 100%);
    height: clamp(420px, 56vh, 600px);
}

.anatomy-canvas {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    display: block;
}

.anatomy-leaders {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 3;
}

.anatomy-leaders line {
    stroke: #B99A62;
    stroke-width: 1.4;
}

/* --- 27.4 Floating label chips --- */
.anatomy-labels {
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
}

.anatomy-chip {
    position: absolute;
    transform: translate(-50%, -50%);
    display: inline-flex;
    align-items: center;
    gap: 7px;
    pointer-events: auto;
    cursor: pointer;
    font-family: "Manrope", sans-serif;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: #244536;
    background: rgba(255, 252, 245, 0.92);
    border: 1px solid rgba(185, 154, 98, 0.55);
    border-radius: 999px;
    padding: 5px 12px 5px 8px;
    box-shadow: 0 10px 24px rgba(20, 30, 20, 0.18);
    white-space: nowrap;
    transition: background 0.25s var(--gl-ease), border-color 0.25s var(--gl-ease),
        transform 0.25s var(--gl-ease);
}

.anatomy-chip:hover {
    background: #FFFCF5;
    border-color: #B99A62;
    transform: translate(-50%, -50%) translateY(-1px);
    z-index: 5;
}

.anatomy-chip-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #B99A62;
    box-shadow: 0 0 0 3px rgba(185, 154, 98, 0.22);
    flex: 0 0 auto;
}

/* --- 27.5 Info panel --- */
.anatomy-info {
    position: absolute;
    left: 18px;
    bottom: 18px;
    z-index: 5;
    width: min(300px, calc(100% - 36px));
    max-height: 62%;
    overflow: auto;
    background: rgba(255, 252, 245, 0.94);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(185, 154, 98, 0.5);
    border-radius: 18px;
    padding: 18px 20px;
    box-shadow: 0 24px 50px rgba(20, 30, 20, 0.25);
}

.anatomy-info::-webkit-scrollbar {
    width: 6px;
}

.anatomy-info::-webkit-scrollbar-thumb {
    background: rgba(185, 154, 98, 0.5);
    border-radius: 6px;
}

.anatomy-plant-name {
    font-family: "Playfair Display", Georgia, serif;
    font-size: 22px;
    font-weight: 600;
    color: #244536;
}

.anatomy-plant-latin,
.anatomy-part-latin {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-style: italic;
    font-size: 14px;
    color: #82965C;
    margin-bottom: 8px;
}

.anatomy-plant-blurb {
    font-size: 12.5px;
    line-height: 1.7;
    color: #343A32;
    margin-bottom: 8px;
}

.anatomy-plant-note {
    font-size: 11.5px;
    line-height: 1.65;
    color: #777264;
    margin-bottom: 8px;
}

.anatomy-plant-tip {
    font-family: "Manrope", sans-serif;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: #B99A62;
}

.anatomy-part-tag {
    font-family: "Manrope", sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.22em;
    color: #82965C;
    margin-bottom: 4px;
}

.anatomy-part-tag::before {
    content: "";
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #B99A62;
    margin-right: 8px;
    vertical-align: 1px;
}

.anatomy-plant-name + .anatomy-plant-latin {
    margin-bottom: 10px;
}

.anatomy-info p.anatomy-part-struct,
.anatomy-info p.anatomy-part-fn {
    font-size: 12.5px;
    line-height: 1.7;
    color: #343A32;
    margin-bottom: 8px;
}

.anatomy-info p strong {
    color: #244536;
    font-weight: 600;
}

.anatomy-part-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
}

.anatomy-btn {
    font-family: "Manrope", sans-serif;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #F5F1E8;
    background: #244536;
    border: 1px solid #244536;
    border-radius: 999px;
    padding: 8px 14px;
    cursor: pointer;
    transition: background 0.3s var(--gl-ease), color 0.3s var(--gl-ease);
}

.anatomy-btn:hover {
    background: #526F50;
}

.anatomy-btn-ghost {
    background: transparent;
    color: #244536;
}

.anatomy-btn-ghost:hover {
    background: rgba(130, 150, 92, 0.16);
    color: #244536;
}

.anatomy-help {
    position: absolute;
    left: 50%;
    bottom: 12px;
    transform: translateX(-50%);
    z-index: 4;
    margin: 0;
    font-family: "Manrope", sans-serif;
    font-size: 10px;
    letter-spacing: 0.06em;
    color: rgba(52, 58, 50, 0.55);
    white-space: nowrap;
    pointer-events: none;
}

@media (max-width: 900px) {
    .anatomy-help {
        display: none;
    }

    .anatomy-info {
        left: 12px;
        right: 12px;
        width: auto;
        bottom: 12px;
        max-height: 55%;
        padding: 14px 16px;
    }

    .anatomy-view-actions {
        margin-left: 0;
    }
}

@media (max-width: 640px) {
    .anatomy-canvas-wrap {
        height: 400px;
        border-radius: 20px;
    }

    .anatomy-chip {
        font-size: 10.5px;
        padding: 4px 10px 4px 7px;
    }
}

/* =========================================================
   28. SEMANTIC THEME TOKENS
   One theme system: body.dark-mode + localStorage
   greenLivingTheme. Semantic aliases resolve onto the
   --gl-* brand tokens so every existing rule follows the
   required palettes without a second theme system.

   Light palette (required):
   bg #F5F1E8 · secondary #EDE7DA · card #FFFCF5 ·
   headings #244536 · body #343A32 · secondary #625F54 ·
   nav #344B3B · olive #82965C · sage #A4B39A ·
   champagne #B99A62 · borders #DED6C7 ·
   button #244536 / #FFFFFF
   ========================================================= */
:root {
    /* semantic aliases → brand tokens */
    --bg-primary: var(--gl-ivory);
    --bg-secondary: var(--gl-sand);
    --bg-card: var(--gl-paper);
    --text-heading: var(--gl-forest);
    --text-primary: var(--gl-ink);
    --text-secondary: var(--gl-muted);
    --text-muted: var(--gl-muted);
    --accent-primary: var(--gl-moss);
    --accent-gold: var(--gl-gold);
    --border-color: var(--gl-line);
    --button-bg: var(--gl-deep);
    --button-text: #FFFFFF;
    --nav-bg: var(--gl-nav);
    --focus-ring: rgba(130, 150, 92, 0.55);

    /* palette corrections (win the cascade over layer 25) */
    --gl-muted: #625F54;        /* secondary text */
}

/* --- required dark palette ---
   bg #071323 · secondary #102C21 · card #173D2B ·
   headings #FFFDF7 · body #E6E8DF · secondary #C5D0C1 ·
   olive #A4B879 · sage #A4B39A · champagne #C5A66B ·
   borders #345344 · button #82965C / #071323 */
body.dark-mode {
    --bg-primary: var(--gl-ivory);
    --bg-secondary: var(--gl-sand);
    --bg-card: var(--gl-paper);
    --text-heading: var(--gl-forest);
    --text-primary: var(--gl-ink);
    --text-secondary: var(--gl-muted);
    --text-muted: var(--gl-muted);
    --accent-primary: var(--gl-moss);
    --accent-gold: var(--gl-gold);
    --border-color: var(--gl-line);
    --button-bg: var(--gl-moss);
    --button-text: #071323;
    --nav-bg: #E6E8DF;
    --focus-ring: rgba(164, 184, 121, 0.6);

    /* palette corrections (win the cascade over layer 25) */
    --gl-moss: #A4B879;         /* olive accent (dark) */
    --gl-ink: #E6E8DF;          /* body text */
    --gl-nav: #E6E8DF;          /* navigation text */
    --gl-muted: #C5D0C1;        /* secondary text */
}

/* Primary buttons follow the theme palette */
body.dark-mode .btn:not(.btn-outline):not(.text-link),
body.dark-mode .anatomy-btn:not(.anatomy-btn-ghost) {
    background: var(--button-bg);
    border-color: var(--button-bg);
    color: var(--button-text);
}

body.dark-mode .btn:not(.btn-outline):not(.text-link):hover {
    background: #B7C68F;
    border-color: #B7C68F;
    color: #071323;
}

/* Focus visibility in both themes */
:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
}

/* Hero: cinematic overlay stays over the video in both themes —
   dark scrim guarantees readable ivory text everywhere. */
body.dark-mode .hero-overlay {
    background: linear-gradient(
        100deg,
        rgba(4, 11, 7, 0.94) 0%,
        rgba(4, 11, 7, 0.7) 46%,
        rgba(4, 11, 7, 0.34) 100%
    ) !important;
}

/* =========================================================
   29. STUDIO 3-PANEL GRID — Garden Studio rebuild
   Intro block, mode-tab panel, Space Designer (in-flow
   toolbar — layer 23 absolute overlap fix) and the Plant
   Anatomy 3-panel grid: left plant card · centre 3D stage ·
   right structure list + part info.
   ========================================================= */

/* --- 29.1 Theme-aware studio scrim (photo stays) --- */
body:not(.dark-mode) .studio-backdrop-photo {
    filter: blur(18px) saturate(0.88) brightness(1.1);
}

body:not(.dark-mode) .studio-backdrop-overlay {
    background:
        linear-gradient(180deg, rgba(245, 241, 232, 0.94) 0%, rgba(237, 231, 218, 0.88) 42%, rgba(237, 231, 218, 0.97) 100%),
        radial-gradient(120% 90% at 50% 42%, transparent 40%, rgba(222, 214, 199, 0.5) 100%);
}

body.dark-mode .studio-backdrop-overlay {
    background:
        linear-gradient(180deg, rgba(4, 12, 9, 0.72) 0%, rgba(6, 17, 12, 0.4) 42%, rgba(4, 12, 9, 0.85) 100%),
        radial-gradient(120% 90% at 50% 42%, transparent 40%, rgba(4, 12, 9, 0.6) 100%);
}

/* --- 29.2 Intro block --- */
.studio-intro {
    position: relative;
    z-index: 2;
    max-width: 820px;
    margin: 0 auto clamp(26px, 3.4vw, 44px);
    text-align: center;
}

.studio-intro .eyebrow {
    color: var(--accent-gold) !important;
}

.studio-intro .studio-heading {
    color: var(--text-heading);
}

.studio-intro .studio-heading em {
    color: var(--accent-gold);
}

.studio-intro .studio-lead {
    color: var(--text-primary);
    max-width: 640px;
    margin: 0 auto 12px;
}

.studio-intro .studio-support {
    color: var(--text-secondary);
    margin-bottom: 0;
}

/* --- 29.3 Studio panel (hosts both modes) --- */
.studio-panel {
    position: relative;
    z-index: 2;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 26px;
    padding: clamp(16px, 2.2vw, 26px);
    box-shadow: var(--gl-shadow-md);
}

body.dark-mode .studio-panel {
    background: rgba(23, 61, 43, 0.9);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
}

.studio-panel .studio-preview-head {
    justify-content: space-between;
}

/* glass tool pills follow the theme */
.studio-panel .studio-tool {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
}

.studio-panel .studio-tool:hover {
    background: var(--bg-card);
    border-color: var(--accent-gold);
    color: var(--text-heading);
}

.studio-panel .anatomy-plant.active,
.studio-panel .anatomy-mode.active {
    background: var(--accent-primary);
    border-color: var(--accent-gold);
    color: var(--button-text);
}

/* --- 29.4 Space Designer (in-flow, no overlay) --- */
.studio-space-wrap[hidden] {
    display: none !important;
}

.studio-space-wrap {
    display: grid;
    grid-template-columns: minmax(270px, 320px) minmax(0, 1fr);
    gap: 18px;
    align-items: start;
}

.studio-space-controls {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
}

.studio-space-controls .studio-controls-label {
    color: var(--text-secondary);
}

.studio-space-controls .space-option {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
}

.studio-space-controls .space-option strong {
    color: var(--text-heading);
}

.studio-space-controls .space-option small {
    color: var(--text-secondary);
}

.studio-space-controls .space-option:hover {
    border-color: var(--accent-gold);
}

.studio-space-controls .space-option.active {
    background: rgba(130, 150, 92, 0.16);
    border-color: var(--accent-primary);
}

body.dark-mode .studio-space-controls .space-option.active {
    background: rgba(164, 184, 121, 0.14);
}

.studio-space-controls .studio-result {
    background: transparent;
    border: 0;
    color: var(--text-secondary);
}

.studio-space-controls .studio-result strong {
    color: var(--text-heading);
}

.studio-space-controls .studio-space-copy,
.studio-space-controls .studio-lighting-copy {
    color: var(--text-secondary);
}

.studio-space-viewer {
    min-width: 0;
    display: flex;
    flex-direction: column;
}

.studio-space-viewer .studio-3d-viewer {
    background: var(--bg-secondary);
    border-color: var(--border-color);
    box-shadow: var(--gl-shadow-sm);
}

.studio-space-viewer .studio-3d-view {
    width: 100% !important;
    height: clamp(380px, 52vh, 560px) !important;
    cursor: grab;
}

.studio-space-viewer .studio-3d-view:active {
    cursor: grabbing;
}

.studio-3d-viewer .plant-loading {
    background: var(--bg-card);
    color: var(--text-primary);
    border-color: var(--border-color);
    box-shadow: var(--gl-shadow-sm);
}

.studio-3d-viewer .plant-error {
    color: #B96F48;
}

body.dark-mode .studio-3d-viewer .plant-error {
    color: #E8C9B4;
}

.studio-3d-viewer .studio-preview-actions {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 8;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}

/* layer-23 overlap fix: toolbar lives in the flow */
.studio-toolbar {
    position: static !important;
    left: auto;
    right: auto;
    bottom: auto;
    transform: none !important;
    z-index: auto;
    width: auto;
    max-width: none;
    margin-top: 12px;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    box-shadow: var(--gl-shadow-sm);
}

.studio-toolbar-label {
    color: var(--text-secondary);
}

.studio-hint {
    margin-top: 8px;
    color: var(--text-secondary);
    font-size: 11.5px;
}

/* --- 29.5 Plant Anatomy — 3-panel grid --- */
.anatomy-viewer[hidden] {
    display: none !important;
}

.anatomy-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 2px 2px 14px;
    flex-wrap: wrap;
}

.anatomy-head-label {
    margin: 0;
    font-family: "Manrope", sans-serif;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.22em;
    color: var(--text-secondary);
    white-space: nowrap;
}

/* the library label now lives in .anatomy-head-label */
.anatomy-library::before {
    content: none;
}

.anatomy-grid {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr) 285px;
    grid-template-areas: "left stage right";
    gap: 14px;
    align-items: stretch;
}

.anatomy-plant-card { grid-area: left; }
.anatomy-stage { grid-area: stage; min-width: 0; }
.anatomy-side-card { grid-area: right; }

.anatomy-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 18px;
    padding: 16px;
    height: clamp(430px, 56vh, 600px);
    overflow-y: auto;
    scrollbar-width: thin;
}

body.dark-mode .anatomy-card {
    background: rgba(16, 44, 33, 0.65);
}

.anatomy-card::-webkit-scrollbar {
    width: 6px;
}

.anatomy-card::-webkit-scrollbar-thumb {
    background: rgba(130, 150, 92, 0.45);
    border-radius: 6px;
}

/* stage column: controls row + canvas */
.anatomy-stage {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.anatomy-stage-head {
    display: flex;
    align-items: center;
    gap: 8px 10px;
    flex-wrap: wrap;
}

.anatomy-stage-head .anatomy-view-actions {
    margin-left: auto;
}

.anatomy-stage .anatomy-canvas-wrap {
    flex: 1;
    height: auto;
    min-height: clamp(380px, 50vh, 560px);
    background: var(--bg-secondary);
    border-color: var(--border-color);
    box-shadow: var(--gl-shadow-sm);
}

body:not(.dark-mode) .anatomy-stage .anatomy-canvas-wrap {
    background:
        radial-gradient(120% 90% at 50% 0%, #FFFCF5 0%, #F4EFE2 58%, #EDE7DA 100%);
}

body.dark-mode .anatomy-stage .anatomy-canvas-wrap {
    background:
        radial-gradient(120% 90% at 50% 0%, #1C4632 0%, #102C21 60%, #0B2118 100%);
}

/* info block (was a floating panel in layer 27) */
.anatomy-info {
    position: static;
    width: auto;
    max-height: none;
    overflow: visible;
    background: transparent;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    padding: 0;
}

.anatomy-info + .anatomy-info {
    margin-top: 0;
}

/* part info text follows the theme */
.anatomy-card .anatomy-plant-name {
    color: var(--text-heading);
}

.anatomy-card .anatomy-plant-latin,
.anatomy-card .anatomy-part-latin {
    color: var(--accent-primary);
}

.anatomy-card .anatomy-plant-blurb,
.anatomy-card .anatomy-plant-note,
.anatomy-card p.anatomy-part-struct,
.anatomy-card p.anatomy-part-fn {
    color: var(--text-primary);
}

.anatomy-card .anatomy-plant-note {
    color: var(--text-secondary);
}

.anatomy-card .anatomy-info p strong {
    color: var(--text-heading);
}

.anatomy-card .anatomy-plant-tip {
    color: var(--accent-gold);
}

.anatomy-card .anatomy-part-tag {
    color: var(--accent-primary);
}

.anatomy-card .anatomy-btn {
    background: var(--button-bg);
    border-color: var(--button-bg);
    color: var(--button-text);
}

.anatomy-card .anatomy-btn:hover {
    background: var(--accent-primary);
    border-color: var(--accent-primary);
    color: var(--button-text);
}

.anatomy-card .anatomy-btn-ghost {
    background: transparent;
    border-color: var(--border-color);
    color: var(--text-primary);
}

.anatomy-card .anatomy-btn-ghost:hover {
    background: rgba(130, 150, 92, 0.14);
    color: var(--text-heading);
}

/* --- 29.6 Left card — plant identity + care --- */
.anatomy-care {
    margin-top: 14px;
    border-top: 1px solid var(--border-color);
    padding-top: 12px;
}

.anatomy-care-title {
    font-family: "Manrope", sans-serif;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.22em;
    color: var(--accent-gold);
    margin-bottom: 10px;
}

.anatomy-care-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 9px;
}

.anatomy-care-list li {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.anatomy-care-k {
    font-family: "Manrope", sans-serif;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-primary);
}

.anatomy-care-v {
    font-size: 12px;
    line-height: 1.55;
    color: var(--text-primary);
}

/* --- 29.7 Right card — structure list + part info --- */
.anatomy-partlist {
    margin-bottom: 14px;
}

.anatomy-partlist-title {
    font-family: "Manrope", sans-serif;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.22em;
    color: var(--text-secondary);
    margin-bottom: 10px;
}

.anatomy-partlist-items {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.anatomy-part-item {
    display: flex;
    align-items: center;
    gap: 9px;
    width: 100%;
    text-align: left;
    font-family: "Manrope", sans-serif;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--text-primary);
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: 8px 11px;
    cursor: pointer;
    transition: background 0.25s var(--gl-ease), border-color 0.25s var(--gl-ease),
        color 0.25s var(--gl-ease);
}

.anatomy-part-item:hover {
    border-color: var(--accent-primary);
    background: rgba(130, 150, 92, 0.1);
}

.anatomy-part-item.active {
    background: var(--accent-primary);
    border-color: var(--accent-gold);
    color: var(--button-text);
}

body.dark-mode .anatomy-part-item.active {
    background: var(--accent-primary);
    color: #071323;
}

.anatomy-part-item-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-gold);
    flex: 0 0 auto;
}

.anatomy-part-item.active .anatomy-part-item-dot {
    background: var(--button-text);
}

/* --- 29.8 Loading pill --- */
.anatomy-loading {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 6;
    margin: 0;
    font-family: "Manrope", sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--text-primary);
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 999px;
    padding: 11px 20px;
    box-shadow: var(--gl-shadow-md);
    pointer-events: none;
}

.anatomy-loading[hidden] {
    display: none !important;
}

/* --- 29.9 Labels & chips in both themes --- */
body.dark-mode .anatomy-chip {
    color: #E6E8DF;
    background: rgba(23, 61, 43, 0.92);
    border-color: rgba(197, 166, 107, 0.5);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.45);
}

